// NextMav Procure — Prisma Schema
// Canonical persistence model for the multi-tenant Procure-to-Pay platform.
// Supabase PostgreSQL 17. See docs/DATA_ARCHITECTURE.md for the whole picture.
//
// Tenancy rule: every tenant-scoped table carries `organizationId` and is indexed
// on it. All access goes through the org-scoped query guard in
// `src/server/tenancy.ts`, which injects the filter into every operation on all 43
// tenant-scoped models — including findUnique, update and delete by primary key.
// Never query these models directly from a route handler.
//
// Money rule: every monetary and quantity column is `numeric(18,4)` (rates 9,4), so
// Postgres aggregates them exactly. Prisma returns those as Decimal; the generated
// extension in `src/server/decimal-fields.ts` converts them to `number` on read, so
// application code works in plain numbers. Aggregates (`_sum`) stay Decimal on
// purpose — the compiler then flags every place a total is computed.
//
// Lifecycle rule: no service assigns `status` directly. Every transition goes
// through `src/server/state-machine.ts`, which is the authoritative definition of
// each document lifecycle; the diagrams in the comments below describe those tables.
//
// Numbering rule: human-facing document numbers (REQ-, RFQ-, PO-, GRN-, INV-, PAY-, CTR-)
// are unique *within* an organization, not globally — see the @@unique([organizationId, …]).
//
// Supabase rule: any migration that adds a table must be followed by
// `npm run db:harden`. Supabase publishes the `public` schema through PostgREST, so
// a table without row-level security is readable by anyone holding the browser key.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Pooled connection, used by the application at runtime. On Vercel every
  // request may land in a new serverless container, so connections must come
  // from a pooler rather than opening a direct one each time.
  url = env("DATABASE_URL")

  // Unpooled connection, used only by migrations. Schema changes need a real
  // session, which a transaction-mode pooler cannot provide.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ===========================================================================
// ORGANIZATION / TENANCY
// ===========================================================================

model Organization {
  id                   String             @id @default(cuid())
  name                 String
  legalName            String?
  industry             String?
  country              String?
  currency             String             @default("USD")
  taxId                String?
  logoUrl              String?
  address              String?
  phone                String?
  website              String?
  fiscalYearStartMonth Int                @default(1)
  timezone             String             @default("UTC")
  status               OrganizationStatus @default(ACTIVE)
  // Tenant-level configuration (approval defaults, tolerances, numbering options).
  // Structured server-managed document — jsonb, not a stringified blob.
  settings             Json?

  // Branding (was BrandingConfig in types.ts)
  brandPrimaryColor String?
  brandAccentColor  String?
  brandLogoUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches             Branch[]
  departments          Department[]
  users                User[]
  vendors              Vendor[]
  requests             PurchaseRequest[]
  templates            RequestTemplate[]
  recurringRequests    RecurringRequest[]
  rfqs                 RFQ[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  invoices             Invoice[]
  payments             Payment[]
  contracts            Contract[]
  assets               Asset[]
  inventoryItems       InventoryItem[]
  documents            DocumentRecord[]
  budgets              Budget[]
  workflows            ApprovalWorkflow[]
  integrations         Integration[]
  activities           ActivityLog[]
  auditLogs            AuditLogEntry[]
  notifications        Notification[]
  savedViews           SavedView[]
  signatures           DigitalSignature[]
  supplierUsers        SupplierUser[]
  costCenters          CostCenter[]
  roles                Role[]
  roleAssignments      UserRoleAssignment[]
  categories           ProcurementCategory[]
  warehouses           Warehouse[]
  approvalInstances    ApprovalInstance[]
  approvalDelegations  ApprovalDelegation[]
  quotations           Quotation[]
  rfqAwards            RFQAward[]
  paymentAllocations   PaymentAllocation[]
  invoiceExceptions    InvoiceMatchException[]
  documentLinks        DocumentLink[]
  storedFiles          StoredFile[]
  outboxEvents         EventOutbox[]
  vendorCategories     VendorCategoryLink[]
  vendorCompliance     VendorComplianceRequirement[]
  vendorNotes          VendorNote[]
  sourcingEvents       SourcingEvent[]
  clarifications       RFQClarification[]
  awardRecommendations AwardRecommendation[]
}

// A physical location: office, plant, site. Warehouses and assets hang off it.
model Branch {
  id             String   @id @default(cuid())
  organizationId String
  code           String?
  name           String
  address        String?
  city           String?
  country        String?
  timezone       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]
  users        User[]
  assets       Asset[]
  warehouses   Warehouse[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  // Departments nest: "Engineering" → "Platform". Approval routing and budget
  // rollups both walk this hierarchy.
  parentId       String?
  costCenterId   String?
  name           String
  code           String?
  managerId      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentTree")
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  manager      User?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)

  users          User[]
  requests       PurchaseRequest[]
  budgets        Budget[]
  templates      RequestTemplate[]
  assets         Asset[]
  purchaseOrders PurchaseOrder[]
  contracts      Contract[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([parentId])
  @@index([costCenterId])
  @@index([managerId])
}

// Where spend is charged. A cost centre is the finance-side counterpart of a
// department: budgets, requests, POs and invoices all carry one so that spend
// can be reported along the finance hierarchy rather than the org chart.
model CostCenter {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  ownerId        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("CostCenterOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  departments    Department[]
  users          User[]
  budgets        Budget[]
  requests       PurchaseRequest[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([ownerId])
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

// ===========================================================================
// IDENTITY — internal users
// ===========================================================================

enum UserRole {
  SUPER_ADMIN
  PROCUREMENT_MANAGER
  FINANCE_OFFICER
  DEPARTMENT_MANAGER
  EMPLOYEE
  AUDITOR
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

model User {
  id                String     @id @default(cuid())
  organizationId    String
  branchId          String?
  departmentId      String?
  email             String
  name              String
  role              UserRole   @default(EMPLOYEE)
  status            UserStatus @default(ACTIVE)
  jobTitle          String?
  phone             String?
  avatarColor       String     @default("bg-emerald-500")
  initials          String     @default("")
  // Supabase Auth owns credentials, email verification and password recovery.
  // This column is the join between `auth.users.id` and the application identity,
  // and it — not the email address — is the permanent identity reference: an
  // address can be changed or reused across tenants, an auth id cannot.
  //
  // Nullable because a User row can exist before its auth user does (an invited
  // employee who has not yet accepted), and because the supplier realm and the
  // seeded demo tenant predate the link. Unique so one auth identity can never
  // resolve to two application users.
  authUserId        String?    @unique
  // Retained only for the supplier realm's scrypt hashes and for the migration
  // window. Internal sign-in no longer reads it; Supabase holds the credential.
  passwordHash      String?
  mfaEnabled        Boolean    @default(false)
  mfaSecret         String?
  lastLoginAt       DateTime?
  // Per-user permission grants layered over the role defaults. JSON array of Permission literals.
  customPermissions String?
  employeeNumber    String?
  costCenterId      String?
  managerId         String?
  timezone          String?
  locale            String?
  deactivatedAt     DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  sessions               Session[]
  costCenter             CostCenter?                   @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  manager                User?                         @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports          User[]                        @relation("UserManager")
  requests               PurchaseRequest[]             @relation("RequestRequester")
  approvals              ApprovalStep[]                @relation("ApprovalApprover")
  delegatedApprovals     ApprovalStep[]                @relation("ApprovalDelegate")
  comments               Comment[]
  watching               RequestWatcher[]
  activities             ActivityLog[]
  auditLogs              AuditLogEntry[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  savedViews             SavedView[]
  goodsReceipts          GoodsReceipt[]
  approvedInvoices       Invoice[]                     @relation("InvoiceApprover")
  processedPayments      Payment[]
  assignedAssets         Asset[]                       @relation("AssetAssignee")
  stockMovements         StockMovement[]
  uploadedDocuments      DocumentRecord[]
  signatures             DigitalSignature[]
  aiConversations        AIConversation[]
  roleAssignments        UserRoleAssignment[]          @relation("RoleAssignmentUser")
  roleGrantsMade         UserRoleAssignment[]          @relation("RoleAssignmentGrantedBy")
  managedDepartments     Department[]                  @relation("DepartmentManager")
  ownedCostCenters       CostCenter[]                  @relation("CostCenterOwner")
  delegationsGiven       ApprovalDelegation[]          @relation("DelegationFrom")
  delegationsReceived    ApprovalDelegation[]          @relation("DelegationTo")
  quotationScores        QuotationScore[]
  rfqAwards              RFQAward[]
  resolvedExceptions     InvoiceMatchException[]
  documentLinks          DocumentLink[]
  vendorAssessments      VendorRiskAssessment[]
  vendorsCreated         Vendor[]                      @relation("VendorCreatedBy")
  vendorsApproved        Vendor[]                      @relation("VendorApprovedBy")
  vendorDocsUploaded     VendorDocument[]              @relation("VendorDocUploadedBy")
  vendorDocsVerified     VendorDocument[]              @relation("VendorDocVerifiedBy")
  complianceReviews      VendorComplianceRequirement[] @relation("ComplianceReviewedBy")
  complianceWaivers      VendorComplianceRequirement[] @relation("ComplianceWaivedBy")
  vendorNotes            VendorNote[]                  @relation("VendorNoteAuthor")
  managedWarehouses      Warehouse[]
  approvalDecisions      ApprovalInstance[]            @relation("ApprovalInstanceDecidedBy")
  sourcingEventsOwned    SourcingEvent[]               @relation("SourcingEventOwner")
  sourcingEventsCreated  SourcingEvent[]               @relation("SourcingEventCreatedBy")
  rfqsApproved           RFQ[]                         @relation("RFQApprovedBy")
  rfqsPublished          RFQ[]                         @relation("RFQPublishedBy")
  rfqsClosed             RFQ[]                         @relation("RFQClosedBy")
  rfqInvitationsSent     RFQVendor[]                   @relation("RFQInvitedBy")
  rfqRevisionsAllowed    RFQVendor[]                   @relation("RFQRevisionAllowedBy")
  rfqEvaluatorSeats      RFQEvaluator[]                @relation("RFQEvaluatorUser")
  rfqEvaluatorsAssigned  RFQEvaluator[]                @relation("RFQEvaluatorAssignedBy")
  clarificationsRaised   RFQClarification[]            @relation("ClarificationAskedBy")
  clarificationsAnswered RFQClarification[]            @relation("ClarificationAnsweredBy")
  awardsRecommended      AwardRecommendation[]         @relation("AwardRecommendedBy")
  awardsDecided          AwardRecommendation[]         @relation("AwardDecidedBy")
  rfqAwardsApproved      RFQAward[]                    @relation("RFQAwardApprovedBy")

  // Email is unique per tenant, not globally — the same person may exist in two orgs.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([departmentId])
  @@index([email])
  @@index([branchId])
  @@index([costCenterId])
  @@index([managerId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Role → permission overrides configured per organization (settings/roles screen).
// ---------------------------------------------------------------------------
// AUTHORIZATION — roles and permissions as data, not as code
// ---------------------------------------------------------------------------
//
// The permission *catalog* is a code constant (`Permission` in src/lib/types.ts):
// it enumerates what the application is able to check, so it can only change when
// the application changes. Everything else lives here:
//
//   Role                 a named bundle of permissions, per organization
//   RolePermission       which permissions the role grants
//   UserRoleAssignment   which roles a user holds (a user may hold several)
//
// An organization can therefore define "Warehouse Officer" or "Category Buyer"
// and route approvals to it without a code change. `User.role` remains as the
// primary role for reporting and as the bootstrap default before any role has
// been assigned; `Role.legacyRole` ties a role row back to that enum.

model Role {
  id             String    @id @default(cuid())
  organizationId String
  // Stable machine key, e.g. PROCUREMENT_OFFICER. Unique per organization.
  key            String
  name           String
  description    String?
  // System roles ship with the platform and cannot be deleted, only re-permissioned.
  isSystem       Boolean   @default(false)
  // Seniority, used to resolve escalation targets and to order the roles screen.
  rank           Int       @default(0)
  // Maps this role onto the legacy enum where one applies, so workflow stages and
  // signatures configured against the enum keep resolving.
  legacyRole     UserRole?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions      RolePermission[]
  assignments      UserRoleAssignment[]
  approverStages   ApprovalWorkflowStage[] @relation("StageApproverRole")
  escalationStages ApprovalWorkflowStage[] @relation("StageEscalationRole")

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  // A literal from the `Permission` catalog. Validated on write against that
  // catalog, so an unknown permission can never be persisted.
  permission String
  createdAt  DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
}

model UserRoleAssignment {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  // Optional scoping: a role held only for one department or cost centre.
  departmentId   String?
  grantedById    String?
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("RoleAssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, departmentId])
  @@index([organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([grantedById])
}

// ===========================================================================
// IDENTITY — external supplier users (separate credential + permission space)
// ===========================================================================

enum SupplierPortalAccess {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

// Deliberately NOT a `User`. Supplier sessions must never carry an internal role,
// and no internal query may resolve a SupplierUser into the employee identity space.
model SupplierUser {
  id              String               @id @default(cuid())
  organizationId  String
  vendorId        String
  email           String
  contactName     String
  passwordHash    String?
  accessStatus    SupplierPortalAccess @default(PENDING)
  inviteToken     String?              @unique
  inviteExpiresAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor               Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sessions             SupplierSession[]
  quotationsSubmitted  Quotation[]
  clarificationsRaised RFQClarification[]

  @@unique([organizationId, email])
  @@index([vendorId])
  @@index([organizationId])
}

model SupplierSession {
  id             String   @id @default(cuid())
  sessionToken   String   @unique
  supplierUserId String
  expires        DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  supplierUser SupplierUser @relation(fields: [supplierUserId], references: [id], onDelete: Cascade)

  @@index([supplierUserId])
}

enum SupplierActivityType {
  RFQ_RECEIVED
  RFQ_VIEWED
  RFQ_ACCEPTED
  RFQ_DECLINED
  QUOTE_DRAFTED
  QUOTE_SUBMITTED
  QUOTE_REVISED
  QUOTE_WITHDRAWN
  CLARIFICATION_ASKED
  CLARIFICATION_ANSWERED
  AWARD_RECEIVED
  AWARD_LOST
  PO_ACKNOWLEDGED
  DELIVERY_CONFIRMED
  INVOICE_SUBMITTED
  PAYMENT_RECEIVED
  MESSAGE_RECEIVED
  DOCUMENT_UPLOADED
}

model SupplierActivity {
  id          String               @id @default(cuid())
  vendorId    String
  type        SupplierActivityType
  description String
  referenceId String?
  createdAt   DateTime             @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([createdAt])
}

// ===========================================================================
// VENDOR MASTER
// ===========================================================================

// The vendor lifecycle. Transitions are enforced by `VENDOR_TRANSITIONS` in
// src/server/state-machine.ts; no service writes `status` without going through it.
//
//   PROSPECTIVE → INVITED → ONBOARDING → UNDER_REVIEW → PENDING_APPROVAL
//               → APPROVED → ACTIVE ⇄ SUSPENDED → INACTIVE → ARCHIVED
//
// REJECTED ends an onboarding without blacklisting the company; BLACKLISTED is the
// deliberate bar on ever trading with them again.
//
// "Preferred" is deliberately NOT a member. A preferred supplier is an active
// supplier the organization favours — it is a flag on a trading relationship, not
// a stage of one, and modelling it as a status made every preferred vendor
// invisible to a query for active vendors.
enum VendorStatus {
  PROSPECTIVE
  INVITED
  ONBOARDING
  UNDER_REVIEW
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  REJECTED
  SUSPENDED
  INACTIVE
  ARCHIVED
  BLACKLISTED
}

enum VendorType {
  SUPPLIER
  MANUFACTURER
  DISTRIBUTOR
  CONTRACTOR
  SERVICE_PROVIDER
  CONSULTANT
  OTHER
}

enum VendorBusinessSize {
  MICRO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

// Derived from the vendor's compliance requirements — never set directly by a
// user. See `deriveComplianceState` in src/server/services/vendor-service.ts.
enum VendorComplianceState {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
  EXPIRED
  UNDER_REVIEW
}

enum VendorRiskStatus {
  UNASSESSED
  ASSESSED
  REVIEW_DUE
  ESCALATED
}

// The vendor master. Every downstream document (RFQ invitation, quotation, PO,
// receipt, invoice, payment, contract) points back here rather than carrying its
// own copy of the supplier's details.
model Vendor {
  id                     String              @id @default(cuid())
  organizationId         String
  // The name the organization trades under and refers to them by. `legalName` is
  // the registered entity, which is frequently different and is what belongs on a
  // contract or a purchase order.
  companyName            String
  legalName              String?
  tradingName            String?
  vendorType             VendorType          @default(SUPPLIER)
  description            String?
  contactPerson          String?
  email                  String?
  phone                  String?
  address                String?
  city                   String?
  stateRegion            String?
  postalCode             String?
  country                String?
  category               String?
  taxNumber              String?
  bankName               String?
  bankAccount            String?
  paymentTerms           String              @default("NET_30")
  preferredCurrency      String              @default("USD")
  status                 VendorStatus        @default(PROSPECTIVE)
  // A favoured trading relationship, orthogonal to the lifecycle. See the note on
  // `VendorStatus`.
  isPreferred            Boolean             @default(false)
  // Human-facing supplier code, unique per organization.
  code                   String?
  registrationNumber     String?
  businessClassification String?
  businessSize           VendorBusinessSize?
  incorporatedOn         DateTime?
  website                String?
  leadTimeDays           Int?                @default(0)
  minimumOrderValue      Decimal?            @db.Decimal(18, 4)
  onboardedAt            DateTime?

  // Manual/qualitative rating (0-5). Distinct from the derived performance figures below.
  rating Float   @default(0)
  notes  String?
  // JSON string array.
  tags   String?

  // --- Derived performance. Recomputed by the scorecard service from receipts,
  // --- invoices and payments; never written directly by a UI mutation.
  totalOrders          Int       @default(0)
  totalValue           Decimal   @default(0) @db.Decimal(18, 4)
  complianceScore      Float     @default(0)
  onTimeDeliveryRate   Float     @default(0)
  qualityRating        Float     @default(0)
  performanceUpdatedAt DateTime?

  // --- Risk. `riskScore` is the latest VendorRiskAssessment's score; the
  // --- assessments themselves are kept as history.
  riskLevel      VendorRiskLevel @default(UNRATED)
  riskScore      Float?
  riskReviewedAt DateTime?

  // --- Compliance. `complianceState` is derived from the requirement rows below;
  // --- `complianceScore` is the proportion of mandatory requirements verified.
  complianceState VendorComplianceState @default(NOT_STARTED)

  riskStatus       VendorRiskStatus @default(UNASSESSED)
  riskNextReviewAt DateTime?

  // --- Lifecycle stamps. Each is written only by the transition that earns it.
  createdById          String?
  invitedAt            DateTime?
  onboardingStartedAt  DateTime?
  submittedForReviewAt DateTime?
  approvedAt           DateTime?
  approvedById         String?
  rejectedAt           DateTime?
  rejectedReason       String?
  activatedAt          DateTime?
  deactivatedAt        DateTime?
  deactivatedReason    String?
  archivedAt           DateTime?

  suspendedAt       DateTime?
  suspendedReason   String?
  blacklistedAt     DateTime?
  blacklistedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization           Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy              User?                         @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy             User?                         @relation("VendorApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  complianceRequirements VendorComplianceRequirement[]
  internalNotes          VendorNote[]
  documents              VendorDocument[]
  rfqInvitations         RFQVendor[]
  quotations             Quotation[]
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  invoices               Invoice[]
  payments               Payment[]
  contracts              Contract[]
  assets                 Asset[]
  inventoryItems         InventoryItem[]
  portalUsers            SupplierUser[]
  activities             SupplierActivity[]
  contacts               VendorContact[]
  categoryLinks          VendorCategoryLink[]
  riskAssessments        VendorRiskAssessment[]
  performanceSnapshots   VendorPerformanceSnapshot[]
  awards                 RFQAward[]
  awardRecommendations   AwardRecommendation[]
  clarifications         RFQClarification[]
  paymentAllocations     PaymentAllocation[]

  @@unique([organizationId, code])
  @@index([organizationId, riskLevel])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, complianceState])
  @@index([createdById])
  @@index([approvedById])
}

enum VendorDocumentType {
  CERTIFICATE
  INSURANCE
  TAX
  CONTRACT
  BANK_PROOF
  OTHER
}

enum ComplianceDocStatus {
  VALID
  EXPIRING
  EXPIRED
  PENDING_REVIEW
}

model VendorDocument {
  id             String              @id @default(cuid())
  vendorId       String
  type           VendorDocumentType
  name           String
  status         ComplianceDocStatus @default(PENDING_REVIEW)
  // The reference the issuing body gave it — a certificate or licence number.
  documentNumber String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  // Superseding a document keeps the old row rather than overwriting it: an award
  // made while a certificate was current must stay explicable after it lapses.
  version        Int                 @default(1)
  supersedesId   String?             @unique
  notes          String?
  // Points at the stored blob; null while metadata-only.
  storedFileId   String?
  uploadedById   String?
  verifiedById   String?
  verifiedAt     DateTime?
  rejectedReason String?
  uploadedAt     DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt

  vendor       Vendor                        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  storedFile   StoredFile?                   @relation(fields: [storedFileId], references: [id], onDelete: SetNull)
  uploadedBy   User?                         @relation("VendorDocUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedBy   User?                         @relation("VendorDocVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  supersedes   VendorDocument?               @relation("VendorDocVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy VendorDocument?               @relation("VendorDocVersions")
  requirements VendorComplianceRequirement[]

  @@index([vendorId])
  @@index([expiresAt])
  @@index([storedFileId])
  @@index([uploadedById])
  @@index([verifiedById])
}

// ===========================================================================
enum VendorRiskLevel {
  UNRATED
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Named people at a supplier. Distinct from SupplierUser: a contact is address-book
// data the buyer maintains; a SupplierUser is a credentialed portal login.
enum VendorContactType {
  GENERAL
  SALES
  FINANCE
  OPERATIONS
  ACCOUNT_MANAGER
  EXECUTIVE
  TECHNICAL
  SUPPORT
}

model VendorContact {
  id         String            @id @default(cuid())
  vendorId   String
  name       String
  email      String?
  phone      String?
  jobTitle   String?
  department String?
  type       VendorContactType @default(GENERAL)
  isPrimary  Boolean           @default(false)
  isActive   Boolean           @default(true)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @default(now()) @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

// ===========================================================================
// VENDOR COMPLIANCE
// ===========================================================================

// The requirements an organization places on a supplier.
//
// Compliance is expressed as individual, evidenced obligations rather than as a
// single boolean, because "compliant" is not a fact about a company — it is a
// fact about which of *this* organization's requirements that company has
// satisfied, which evidence proves it, and when that evidence lapses.
enum VendorComplianceType {
  BUSINESS_REGISTRATION
  TAX_CLEARANCE
  INSURANCE
  CERTIFICATION
  INDUSTRY_LICENCE
  BANK_VERIFICATION
  DATA_PROTECTION
  HEALTH_AND_SAFETY
  ANTI_BRIBERY
  OTHER
}

enum VendorComplianceStatus {
  NOT_STARTED
  PENDING_SUBMISSION
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  WAIVED
}

model VendorComplianceRequirement {
  id             String                 @id @default(cuid())
  organizationId String
  vendorId       String
  type           VendorComplianceType
  name           String
  description    String?
  status         VendorComplianceStatus @default(NOT_STARTED)
  // A non-mandatory requirement is tracked and reviewed but does not hold the
  // vendor out of compliance.
  isMandatory    Boolean                @default(true)
  documentId     String?
  expiresAt      DateTime?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNotes    String?
  // A waiver is a deliberate, attributed exception — §14: nobody marks a vendor
  // compliant over an outstanding requirement without recording who and why.
  waivedById     String?
  waivedReason   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @default(now()) @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  document     VendorDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reviewedBy   User?           @relation("ComplianceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  waivedBy     User?           @relation("ComplianceWaivedBy", fields: [waivedById], references: [id], onDelete: SetNull)

  @@unique([vendorId, type, name])
  @@index([organizationId, status])
  @@index([vendorId])
  @@index([expiresAt])
  @@index([documentId])
  @@index([reviewedById])
  @@index([waivedById])
}

// Buyer-side commentary on a supplier. RESTRICTED notes are readable only by
// users who can approve vendors — a note about a live negotiation or a concern
// under investigation should not be visible to every requester.
//
// Nothing in the supplier realm reads this table.
enum VendorNoteVisibility {
  INTERNAL
  RESTRICTED
}

model VendorNote {
  id             String               @id @default(cuid())
  organizationId String
  vendorId       String
  authorId       String?
  body           String
  visibility     VendorNoteVisibility @default(INTERNAL)
  isPinned       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  author       User?        @relation("VendorNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([vendorId, createdAt])
  @@index([authorId])
}

// Spend taxonomy, shared by vendors, requests, RFQs and budgets. Hierarchical so
// an organization can report on "IT" and drill into "IT / Software".
model ProcurementCategory {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  code           String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       ProcurementCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     ProcurementCategory[] @relation("CategoryTree")

  vendorLinks    VendorCategoryLink[]
  requests       PurchaseRequest[]
  rfqs           RFQ[]
  sourcingEvents SourcingEvent[]
  purchaseOrders PurchaseOrder[]
  contracts      Contract[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentId])
}

// Which categories a supplier is qualified to supply. Sourcing uses this to
// propose an invitation list for an RFQ instead of asking the buyer to remember.
model VendorCategoryLink {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  categoryId     String
  isPreferred    Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category     ProcurementCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([vendorId, categoryId])
  @@index([organizationId])
  @@index([categoryId])
}

// Point-in-time risk review. Kept as history so a supplier's risk trajectory is
// visible and so an award made under an old rating remains explicable.
model VendorRiskAssessment {
  id           String          @id @default(cuid())
  vendorId     String
  level        VendorRiskLevel
  score        Float
  // JSON object of contributing factors: financial, compliance, delivery, concentration.
  factors      Json?
  summary      String?
  assessedById String?
  assessedAt   DateTime        @default(now())
  nextReviewAt DateTime?

  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  assessedBy User?  @relation(fields: [assessedById], references: [id], onDelete: SetNull)

  @@index([vendorId, assessedAt])
  @@index([assessedById])
}

// Derived scorecard for one period. Computed from receipts, invoices and payments —
// never written by a UI mutation — so vendor performance is evidence, not opinion.
model VendorPerformanceSnapshot {
  id              String   @id @default(cuid())
  vendorId        String
  periodStart     DateTime
  periodEnd       DateTime
  ordersCount     Int      @default(0)
  receiptsCount   Int      @default(0)
  onTimeRate      Float    @default(0)
  qualityRate     Float    @default(0)
  complianceScore Float    @default(0)
  disputeCount    Int      @default(0)
  totalSpend      Decimal  @default(0) @db.Decimal(18, 4)
  computedAt      DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, periodStart, periodEnd])
  @@index([vendorId])
}

// PURCHASE REQUESTS
// ===========================================================================

// The request lifecycle. Transitions are enforced in `src/server/state-machine.ts`;
// no service writes `status` without going through it.
//
//   DRAFT → SUBMITTED → UNDER_REVIEW → APPROVED → IN_PROCUREMENT → ORDERED
//         → PARTIALLY_FULFILLED → FULFILLED → CLOSED
//
// RETURNED sends a request back to its owner for revision without rejecting it.
enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  RETURNED
  REJECTED
  CANCELLED
  IN_PROCUREMENT
  ORDERED
  PARTIALLY_FULFILLED
  FULFILLED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PurchaseRequest {
  id                    String        @id @default(cuid())
  organizationId        String
  requestNumber         String
  title                 String
  departmentId          String?
  requestedById         String
  status                RequestStatus @default(DRAFT)
  priority              Priority      @default(MEDIUM)
  category              String?
  // JSON string array.
  tags                  String?
  businessJustification String?
  neededByDate          DateTime?
  totalEstimated        Decimal       @default(0) @db.Decimal(18, 4)
  currency              String        @default("USD")
  version               Int           @default(1)

  // Workflow selected at submission time; pinned so later config changes don't
  // retroactively alter an in-flight approval chain.
  workflowId String?

  // Where the money comes from and where it is charged.
  budgetId     String?
  costCenterId String?
  categoryId   String?
  branchId     String?

  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  returnedAt      DateTime?
  returnReason    String?
  orderedAt       DateTime?
  fulfilledAt     DateTime?
  closedAt        DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  requestedBy  User                 @relation("RequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  workflow     ApprovalWorkflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  budget       Budget?              @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  costCenter   CostCenter?          @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  categoryRef  ProcurementCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  lineItems         RequestLineItem[]
  approvals         ApprovalStep[]
  comments          Comment[]
  watchers          RequestWatcher[]
  versionHistory    RequestVersion[]
  rfqs              RFQ[]
  purchaseOrders    PurchaseOrder[]
  activities        ActivityLog[]
  budgetEntries     BudgetEntry[]
  approvalInstances ApprovalInstance[]
  sourcingEvents    SourcingEvent[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([departmentId])
  @@index([requestedById])
  @@index([budgetId])
  @@index([costCenterId])
  @@index([categoryId])
  @@index([organizationId, createdAt])
  @@index([workflowId])
}

model RequestLineItem {
  id            String   @id @default(cuid())
  requestId     String
  itemName      String
  description   String?
  quantity      Decimal  @db.Decimal(18, 4)
  unit          String   @default("unit")
  estimatedCost Decimal  @db.Decimal(18, 4)
  taxRate       Decimal  @default(0) @db.Decimal(9, 4)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rfqLineItems RFQLineItem[]

  @@index([requestId])
}

// Immutable snapshot taken whenever an approved-stage request is edited.
model RequestVersion {
  id          String   @id @default(cuid())
  requestId   String
  version     Int
  // Full JSON snapshot of the request at this version.
  snapshot    String
  reason      String?
  changedById String
  createdAt   DateTime @default(now())

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, version])
  @@index([requestId])
}

model RequestWatcher {
  id        String   @id @default(cuid())
  requestId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([userId])
}

enum CommentEntityType {
  REQUEST
  PO
  RFQ
  VENDOR
  INVOICE
  CONTRACT
  GOODS_RECEIPT
}

model Comment {
  id         String            @id @default(cuid())
  entityType CommentEntityType
  entityId   String
  requestId  String?
  authorId   String
  content    String
  // JSON array of userIds mentioned.
  mentions   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  author  User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  request PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([authorId])
  @@index([requestId])
}

model RequestTemplate {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  description          String?
  category             String?
  departmentId         String?
  priority             Priority @default(MEDIUM)
  // JSON array of line-item shapes.
  defaultLineItems     String
  defaultJustification String?
  usageCount           Int      @default(0)
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([departmentId])
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model RecurringRequest {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  templateId     String?
  // JSON snapshot of the request body to instantiate on each run.
  payload        String
  frequency      RecurrenceFrequency
  nextRunAt      DateTime
  lastRunAt      DateTime?
  isActive       Boolean             @default(true)
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([nextRunAt, isActive])
}

// ===========================================================================
// APPROVAL WORKFLOW ENGINE
// ===========================================================================

enum ApprovalStage {
  DEPARTMENT_MANAGER
  FINANCE
  PROCUREMENT
  EXECUTIVE
}

// What a workflow governs. One engine approves requests, purchase orders,
// invoices, payments, contracts and budgets — the entity type is data.
enum ApprovalEntityType {
  REQUEST
  PURCHASE_ORDER
  INVOICE
  PAYMENT
  CONTRACT
  BUDGET
  VENDOR
  RFQ
  AWARD
}

enum ApprovalInstanceStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
  RETURNED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SKIPPED
  DELEGATED
}

model ApprovalWorkflow {
  id                String             @id @default(cuid())
  organizationId    String
  name              String
  description       String?
  isActive          Boolean            @default(true)
  entityType        ApprovalEntityType @default(REQUEST)
  // Workflows are versioned rather than edited in place: an in-flight approval
  // keeps the version it started under, and history stays explicable.
  version           Int                @default(1)
  supersededById    String?            @unique
  // Selection predicate. A request picks the highest-priority active workflow whose
  // threshold/priority/department/category filters all match.
  thresholdMin      Decimal?           @db.Decimal(18, 4)
  thresholdMax      Decimal?           @db.Decimal(18, 4)
  // JSON arrays; null means "no constraint on this dimension".
  priorityFilter    String?
  departmentFilter  String?
  categoryFilter    String?
  selectionPriority Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       ApprovalWorkflowStage[]
  instances    ApprovalInstance[]
  supersededBy ApprovalWorkflow?       @relation("WorkflowVersions", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   ApprovalWorkflow?       @relation("WorkflowVersions")
  requests     PurchaseRequest[]

  @@unique([organizationId, name, version])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, entityType, isActive])
}

model ApprovalWorkflowStage {
  id                 String        @id @default(cuid())
  workflowId         String
  name               String
  stage              ApprovalStage
  approverRole       UserRole
  sequence           Int
  slaHours           Int           @default(48)
  escalationRole     UserRole?
  allowDelegation    Boolean       @default(true)
  // Stages sharing a `sequence` run in parallel; all must approve to advance.
  isParallel         Boolean       @default(false)
  // Optional predicate — stage is skipped when it does not match.
  conditionMinAmount Decimal?      @db.Decimal(18, 4)
  conditionMaxAmount Decimal?      @db.Decimal(18, 4)
  description        String?
  // Configured role targets. When set these win over the legacy enum columns,
  // which is what lets an organization route approval to a role it invented.
  approverRoleId     String?
  escalationRoleId   String?
  // For parallel stages: how many of the assigned approvers must approve.
  // 0 means "all of them".
  minApprovals       Int           @default(0)
  isMandatory        Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt

  workflow          ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverRoleRef   Role?            @relation("StageApproverRole", fields: [approverRoleId], references: [id], onDelete: SetNull)
  escalationRoleRef Role?            @relation("StageEscalationRole", fields: [escalationRoleId], references: [id], onDelete: SetNull)
  steps             ApprovalStep[]

  @@index([workflowId])
  @@index([approverRoleId])
  @@index([escalationRoleId])
}

// One running approval over one entity. This is what makes the engine generic:
// the steps below hang off an instance, and the instance names what is being
// approved. A request keeps its direct `requestId` link so the existing
// request → approvals relation stays a first-class query.
model ApprovalInstance {
  id             String                 @id @default(cuid())
  organizationId String
  workflowId     String?
  entityType     ApprovalEntityType
  entityId       String
  requestId      String?
  status         ApprovalInstanceStatus @default(IN_PROGRESS)
  // Snapshot of the facts the workflow was selected on, so a later change to the
  // entity cannot make the routing look wrong in hindsight.
  amount         Decimal?               @db.Decimal(18, 4)
  currency       String                 @default("USD")
  context        Json?
  startedAt      DateTime               @default(now())
  completedAt    DateTime?
  decidedById    String?
  outcomeReason  String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @default(now()) @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     ApprovalWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  request      PurchaseRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decidedBy    User?             @relation("ApprovalInstanceDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  steps        ApprovalStep[]

  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([requestId])
  @@index([workflowId])
  @@index([decidedById])
}

// Standing delegation: "while I am away, my approvals go to X". Distinct from the
// per-step `delegatedToId`, which records a delegation that actually happened.
model ApprovalDelegation {
  id             String              @id @default(cuid())
  organizationId String
  fromUserId     String
  toUserId       String
  // Null means every approval the delegator would receive.
  entityType     ApprovalEntityType?
  reason         String?
  startsAt       DateTime            @default(now())
  endsAt         DateTime?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromUser     User         @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User         @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@index([fromUserId, isActive])
  @@index([toUserId])
}

model ApprovalStep {
  id              String           @id @default(cuid())
  instanceId      String?
  requestId       String?
  stageId         String?
  stage           ApprovalStage
  sequence        Int              @default(0)
  approverId      String
  approverRole    UserRole
  approverRoleId  String?
  decision        ApprovalDecision @default(PENDING)
  comment         String?
  rejectionReason String?
  delegatedToId   String?
  decidedById     String?
  decidedAt       DateTime?
  slaHours        Int              @default(48)
  slaExpiresAt    DateTime?
  isEscalated     Boolean          @default(false)
  escalatedAt     DateTime?
  remindersSent   Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  instance    ApprovalInstance?      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  request     PurchaseRequest?       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stageRef    ApprovalWorkflowStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  approver    User                   @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: Restrict)
  delegatedTo User?                  @relation("ApprovalDelegate", fields: [delegatedToId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([instanceId])
  @@index([approverId, decision])
  @@index([slaExpiresAt])
  @@index([stageId])
  @@index([delegatedToId])
}

// ===========================================================================
// STRATEGIC SOURCING → RFQ → QUOTATION → EVALUATION → AWARD
// ===========================================================================
//
// The chain this section models, end to end:
//
//   PurchaseRequest → SourcingEvent → RFQ → RFQVendor → Quotation
//                                        → QuotationScore → AwardRecommendation
//                                        → RFQAward → (PurchaseOrder, next phase)
//
// Every link is a real foreign key rather than a copied field, so the question a
// procurement manager actually has to answer under audit — "why was this supplier
// selected, and what were we buying?" — is a join, not an archaeology exercise.

// What kind of competitive process is being run. Only RFQ is implemented in this
// phase; the column exists so that adding an RFP or a tender later is a new value
// and a new form, not a second parallel set of tables.
enum SourcingEventType {
  RFQ
  RFP
  RFI
  TENDER
  DIRECT_AWARD
}

// The event's own lifecycle, which is deliberately coarser than the RFQ's. An
// event is a container: it is planning, running, being decided, or finished. The
// fine-grained states (approval, publication, response period) belong to the RFQ
// inside it, because that is the document suppliers actually see.
enum SourcingEventStatus {
  DRAFT
  PLANNING
  ACTIVE
  EVALUATION
  AWARDED
  CLOSED
  CANCELLED
}

/// The sourcing event: an approved requirement turned into a competitive process.
///
/// It exists separately from the RFQ for two reasons. First, traceability — the
/// event is what carries the link back to the purchase request, so a change to the
/// RFQ (a re-issue, a second round) never severs the line back to why the money is
/// being spent. Second, an event can hold more than one RFQ over its life: a failed
/// first round and its replacement are the same sourcing effort, and modelling them
/// as unrelated RFQs loses that.
model SourcingEvent {
  id               String              @id @default(cuid())
  organizationId   String
  eventNumber      String
  title            String
  description      String?
  /// The requirement this event exists to satisfy. Null for an event raised
  /// directly — sourcing a framework agreement, say — which is legitimate but
  /// must be visibly distinct from one traceable to an approved request.
  requestId        String?
  categoryId       String?
  /// The buyer who owns the event and answers for it.
  ownerId          String?
  type             SourcingEventType   @default(RFQ)
  status           SourcingEventStatus @default(DRAFT)
  currency         String              @default("USD")
  estimatedValue   Decimal?            @db.Decimal(18, 4)
  /// Denormalised from the RFQ inside it so the event list can sort and filter on
  /// the date that matters without loading every RFQ.
  responseDeadline DateTime?
  publishedAt      DateTime?
  closedAt         DateTime?
  awardedAt        DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      PurchaseRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  category     ProcurementCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  owner        User?                @relation("SourcingEventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("SourcingEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rfqs         RFQ[]

  @@unique([organizationId, eventNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([requestId])
  @@index([categoryId])
  @@index([ownerId])
  @@index([createdById])
}

/// RFQ lifecycle. Enforced by `RFQ_TRANSITIONS` in src/server/state-machine.ts.
///
///   DRAFT → UNDER_REVIEW → APPROVED → READY_TO_PUBLISH → PUBLISHED
///         → RESPONSE_PERIOD → CLOSED → UNDER_EVALUATION → AWARDED
///
/// Three distinctions in that chain are load-bearing:
///
///   APPROVED vs READY_TO_PUBLISH — approval is a decision by a person; readiness
///   is a fact about the document. An RFQ can be approved and still be missing a
///   line item or an eligible supplier, and publishing it then would produce an
///   invitation nobody can answer. Readiness is asserted by the completeness check
///   in rfq-service, never typed in.
///
///   PUBLISHED vs RESPONSE_PERIOD — published means the invitations went out;
///   response period means at least one supplier has engaged. The buyer dashboard
///   reads very differently for the two, and collapsing them hides a round where
///   nobody responded at all.
///
///   CLOSED vs AWARDED — closed means the door shut on new quotations. Awarding is
///   a later, separate act that may not happen: NO_AWARD is a real outcome and must
///   not be recorded as a cancellation.
enum RFQStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  READY_TO_PUBLISH
  PUBLISHED
  RESPONSE_PERIOD
  CLOSED
  UNDER_EVALUATION
  AWARDED
  NO_AWARD
  EXPIRED
  CANCELLED
}

model RFQ {
  id                     String              @id @default(cuid())
  organizationId         String
  rfqNumber              String
  /// The sourcing event this RFQ belongs to. Nullable only for rows written
  /// before events existed; every RFQ created by the application has one.
  sourcingEventId        String?
  requestId              String?
  title                  String
  description            String?
  /// The organization's own reference — a tender number, a board paper, whatever
  /// they quote internally. Distinct from `rfqNumber`, which the system owns.
  referenceNumber        String?
  deadline               DateTime
  /// Cut-off for clarification questions, which normally precedes the response
  /// deadline so answers can reach everyone in time to matter.
  questionDeadline       DateTime?
  requiredDeliveryDate   DateTime?
  deliveryTerms          String?
  deliveryAddress        String?
  termsAndConditions     String?
  status                 RFQStatus           @default(DRAFT)
  categoryId             String?
  currency               String              @default("USD")
  estimatedValue         Decimal?            @db.Decimal(18, 4)
  /// Whether suppliers see the per-line target price. Off by default: publishing
  /// the budget invites every bid to land just underneath it.
  showTargetPrice        Boolean             @default(false)
  /// Sealed bidding: quotations stay unreadable to the buyer until the deadline.
  isSealed               Boolean             @default(false)
  /// Whether a supplier may replace a submitted quotation on their own initiative.
  /// Off by default — Rule 4. With it off, a revision requires the buyer to invite
  /// one, which is recorded on the invitation.
  allowSupplierRevision  Boolean             @default(false)
  evaluationMethod       RFQEvaluationMethod @default(LOWEST_PRICE)
  submittedForApprovalAt DateTime?
  approvedAt             DateTime?
  approvedById           String?
  publishedAt            DateTime?
  publishedById          String?
  closedAt               DateTime?
  closedById             String?
  evaluatedAt            DateTime?
  selectedQuotationId    String?             @unique
  awardedAt              DateTime?
  awardedById            String?
  cancelledAt            DateTime?
  cancelReason           String?
  remindersSent          Int                 @default(0)
  createdById            String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourcingEvent     SourcingEvent?           @relation(fields: [sourcingEventId], references: [id], onDelete: SetNull)
  request           PurchaseRequest?         @relation(fields: [requestId], references: [id], onDelete: SetNull)
  categoryRef       ProcurementCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  approvedBy        User?                    @relation("RFQApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedBy       User?                    @relation("RFQPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  closedBy          User?                    @relation("RFQClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  criteria          RFQEvaluationCriterion[]
  evaluators        RFQEvaluator[]
  clarifications    RFQClarification[]
  recommendations   AwardRecommendation[]
  awards            RFQAward[]
  lineItems         RFQLineItem[]
  invitedVendors    RFQVendor[]
  quotations        Quotation[]              @relation("RFQQuotations")
  selectedQuotation Quotation?               @relation("RFQSelectedQuotation", fields: [selectedQuotationId], references: [id], onDelete: SetNull)
  purchaseOrders    PurchaseOrder[]
  activities        ActivityLog[]

  @@unique([organizationId, rfqNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([deadline])
  @@index([requestId])
  @@index([categoryId])
  @@index([sourcingEventId])
  @@index([approvedById])
  @@index([publishedById])
  @@index([closedById])
}

model RFQLineItem {
  id                   String    @id @default(cuid())
  rfqId                String
  itemName             String
  description          String?
  /// Free-text technical specification. Kept separate from `description` because
  /// suppliers are asked to confirm compliance against this, not against prose.
  specification        String?
  quantity             Decimal   @db.Decimal(18, 4)
  unit                 String    @default("unit")
  requiredDeliveryDate DateTime?
  /// Internal reference price. Exposed to suppliers only when the RFQ sets
  /// `showTargetPrice`; the supplier-facing serializer strips it otherwise.
  targetPrice          Decimal?  @db.Decimal(18, 4)
  notes                String?
  /// Traceability back to the requested line, so a quoted price can be compared
  /// with what the requester estimated.
  requestLineItemId    String?
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  rfq              RFQ                       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  requestLineItem  RequestLineItem?          @relation(fields: [requestLineItemId], references: [id], onDelete: SetNull)
  quotationLines   QuotationLineItem[]
  recommendedItems AwardRecommendationItem[]

  @@index([rfqId])
  @@index([requestLineItemId])
}

/// Where an invited supplier stands. INVITED → VIEWED → ACCEPTED → QUOTED is the
/// happy path; DECLINED and NO_RESPONSE are the two ways it ends without a bid,
/// and they are kept apart because a decline is information and a silence is not.
enum RFQInvitationStatus {
  INVITED
  VIEWED
  ACCEPTED
  QUOTED
  DECLINED
  NO_RESPONSE
}

model RFQVendor {
  id                  String              @id @default(cuid())
  rfqId               String
  vendorId            String
  status              RFQInvitationStatus @default(INVITED)
  invitedAt           DateTime            @default(now())
  invitedById         String?
  /// First and last time this supplier opened the RFQ, plus a counter. The buyer's
  /// response monitor reads these; they are written by the portal, never asserted.
  viewedAt            DateTime?
  lastViewedAt        DateTime?
  viewCount           Int                 @default(0)
  acceptedAt          DateTime?
  respondedAt         DateTime?
  declinedAt          DateTime?
  declineReason       String?
  /// Set when the buyer explicitly invites a revision of an already-submitted
  /// quotation. This is the only thing that unlocks re-submission when the RFQ
  /// does not allow supplier-initiated revisions — Rule 4.
  revisionAllowedAt   DateTime?
  revisionAllowedById String?
  revisionReason      String?

  rfq               RFQ    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor            Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invitedBy         User?  @relation("RFQInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  revisionAllowedBy User?  @relation("RFQRevisionAllowedBy", fields: [revisionAllowedById], references: [id], onDelete: SetNull)

  @@unique([rfqId, vendorId])
  @@index([vendorId])
  @@index([rfqId, status])
  @@index([invitedById])
  @@index([revisionAllowedById])
}

/// Quotation lifecycle.
///
/// DRAFT is the supplier's own workspace and is invisible to the buyer. SUBMITTED
/// is the bid. SUPERSEDED is what an earlier revision becomes when a later one is
/// accepted — distinct from WITHDRAWN, which is the supplier pulling out, because
/// conflating them would make a routine re-quote look like a retreat.
enum QuotationStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  UNDER_EVALUATION
  SELECTED
  REJECTED
  WITHDRAWN
  SUPERSEDED
  EXPIRED
}

model Quotation {
  id                        String          @id @default(cuid())
  /// Carried directly rather than only through the RFQ: a supplier submits against
  /// a quotation id, and that path must be tenant-scoped without a join.
  organizationId            String
  rfqId                     String
  vendorId                  String
  quotationNumber           String?
  revision                  Int             @default(1)
  /// The revision this one replaces. Keeping the chain explicit means the buyer
  /// can walk V1 → V2 → V3 rather than inferring order from a counter.
  supersedesId              String?         @unique
  /// Money, broken out rather than collapsed into a single total. A buyer
  /// comparing bids has to be able to see that one supplier's cheaper headline is
  /// a shipping charge moved into the unit price.
  subtotal                  Decimal         @default(0) @db.Decimal(18, 4)
  discountAmount            Decimal         @default(0) @db.Decimal(18, 4)
  taxAmount                 Decimal         @default(0) @db.Decimal(18, 4)
  shippingAmount            Decimal         @default(0) @db.Decimal(18, 4)
  /// Derived from the line items and the charges above — never accepted from the
  /// client. §14: totals the system can compute, the system computes.
  totalAmount               Decimal         @db.Decimal(18, 4)
  currency                  String          @default("USD")
  deliveryDays              Int             @default(0)
  warranty                  String?
  paymentTerms              String?
  validUntil                DateTime?
  validityDays              Int?
  supplierReference         String?
  notes                     String?
  status                    QuotationStatus @default(DRAFT)
  /// Set when procurement scores the bid during evaluation.
  evaluationScore           Float?
  evaluationNotes           String?
  /// Weighted total of the QuotationScore rows, recomputed on each scoring change.
  weightedScore             Float?
  rank                      Int?
  isCompliant               Boolean         @default(true)
  complianceNotes           String?
  awardedAt                 DateTime?
  withdrawnAt               DateTime?
  withdrawnReason           String?
  /// Who submitted it: a buyer entering a bid on the supplier's behalf, or the
  /// supplier themselves through the portal. Exactly one is set.
  submittedByUserId         String?
  submittedBySupplierUserId String?
  /// Null while the quotation is a draft. The presence of this timestamp, not the
  /// status alone, is what makes a bid exist as far as the buyer is concerned.
  submittedAt               DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  rfq                     RFQ                   @relation("RFQQuotations", fields: [rfqId], references: [id], onDelete: Cascade)
  selectedForRfq          RFQ?                  @relation("RFQSelectedQuotation")
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor                  Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  supersedes              Quotation?            @relation("QuotationRevisions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy            Quotation?            @relation("QuotationRevisions")
  submittedBySupplierUser SupplierUser?         @relation(fields: [submittedBySupplierUserId], references: [id], onDelete: SetNull)
  scores                  QuotationScore[]
  awards                  RFQAward[]
  recommendations         AwardRecommendation[]
  lineItems               QuotationLineItem[]
  purchaseOrders          PurchaseOrder[]

  @@unique([rfqId, vendorId, revision])
  @@index([rfqId])
  @@index([vendorId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([rfqId, status])
  @@index([submittedBySupplierUserId])
}

model QuotationLineItem {
  id              String   @id @default(cuid())
  quotationId     String
  /// The RFQ line being answered. Nullable so a supplier can offer an alternative
  /// the buyer did not ask for, but the normalised comparison in §26 depends on
  /// this being set wherever it can be.
  rfqLineItemId   String?
  itemName        String
  description     String?
  quantity        Decimal  @db.Decimal(18, 4)
  unit            String   @default("unit")
  unitPrice       Decimal  @db.Decimal(18, 4)
  discountPercent Decimal  @default(0) @db.Decimal(9, 4)
  discountAmount  Decimal  @default(0) @db.Decimal(18, 4)
  taxRate         Decimal  @default(0) @db.Decimal(9, 4)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 4)
  deliveryCost    Decimal  @default(0) @db.Decimal(18, 4)
  /// Computed and stored: quantity × unit price − discount + tax + delivery. Kept
  /// on the row so a comparison query does not have to re-derive it per bid.
  lineTotal       Decimal  @default(0) @db.Decimal(18, 4)
  deliveryDays    Int?
  /// A supplier offering something other than what was asked for. Flagged rather
  /// than hidden: an alternative may be the better buy, but it must never be
  /// silently compared like-for-like against the specified item.
  isAlternative   Boolean  @default(false)
  /// The supplier declining to price this specific line while quoting the rest.
  isNoBid         Boolean  @default(false)
  notes           String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  quotation        Quotation                 @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqLineItem      RFQLineItem?              @relation(fields: [rfqLineItemId], references: [id], onDelete: SetNull)
  recommendedItems AwardRecommendationItem[]

  @@index([quotationId])
  @@index([rfqLineItemId])
}

// ---------------------------------------------------------------------------
// EVALUATION
// ---------------------------------------------------------------------------

enum RFQEvaluationMethod {
  LOWEST_PRICE
  WEIGHTED_SCORE
  QUALITY_THEN_PRICE
}

enum EvaluationCriterionType {
  PRICE
  DELIVERY
  QUALITY
  COMPLIANCE
  WARRANTY
  EXPERIENCE
  TECHNICAL
  SERVICE_LEVEL
  RISK
  OTHER
}

/// What the bids are judged on, and how heavily. Defined before quotations arrive
/// so the yardstick cannot be chosen after seeing the numbers.
model RFQEvaluationCriterion {
  id            String                  @id @default(cuid())
  rfqId         String
  name          String
  description   String?
  type          EvaluationCriterionType @default(OTHER)
  /// Relative weight within the RFQ, as a percentage. Validated to sum to 100
  /// across the RFQ's criteria before it can be published — §27.
  weight        Float                   @default(1)
  /// Higher score wins for most criteria; price-like criteria invert.
  lowerIsBetter Boolean                 @default(false)
  maxScore      Float                   @default(10)
  /// Whether the criterion is scored by a person or derived from the bid itself
  /// (price and delivery can be). Automatic criteria are not put in front of an
  /// evaluator, which keeps the scoring screen to the judgements only a human
  /// can make.
  isAutomatic   Boolean                 @default(false)
  sortOrder     Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @default(now()) @updatedAt

  rfq    RFQ              @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  scores QuotationScore[]

  @@unique([rfqId, name])
  @@index([rfqId])
}

/// Which discipline an evaluator is on the panel for. The role decides which
/// criteria they are asked to score, so a finance reviewer is not made to rate
/// technical compliance they cannot judge.
enum EvaluatorRole {
  PROCUREMENT
  TECHNICAL
  FINANCE
  DEPARTMENT
  EXECUTIVE
}

/// The evaluation panel for one RFQ. §29: multiple evaluators, each seeing only
/// what their role warrants, with the aggregate computed across them.
model RFQEvaluator {
  id           String        @id @default(cuid())
  rfqId        String
  userId       String
  role         EvaluatorRole @default(PROCUREMENT)
  /// The panel chair, who may see every evaluator's scores and close the
  /// evaluation. Other members see only their own — §30.
  isChair      Boolean       @default(false)
  assignedById String?
  assignedAt   DateTime      @default(now())
  completedAt  DateTime?

  rfq        RFQ              @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  user       User             @relation("RFQEvaluatorUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?            @relation("RFQEvaluatorAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  scores     QuotationScore[]

  @@unique([rfqId, userId])
  @@index([rfqId])
  @@index([userId])
  @@index([assignedById])
}

/// One evaluator's score for one bid against one criterion.
///
/// The uniqueness key includes the evaluator on purpose. Keyed on
/// (quotation, criterion) alone — as it was — a second panel member silently
/// overwrote the first, which is both a lost judgement and a breach of Rule 9.
model QuotationScore {
  id          String   @id @default(cuid())
  quotationId String
  criterionId String
  /// Null only for scores recorded before the panel model existed.
  evaluatorId String?
  score       Float
  notes       String?
  scoredById  String?
  scoredAt    DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  quotation Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  criterion RFQEvaluationCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  evaluator RFQEvaluator?           @relation(fields: [evaluatorId], references: [id], onDelete: SetNull)
  scoredBy  User?                   @relation(fields: [scoredById], references: [id], onDelete: SetNull)
  history   QuotationScoreHistory[]

  @@unique([quotationId, criterionId, evaluatorId])
  @@index([quotationId])
  @@index([criterionId])
  @@index([scoredById])
  @@index([evaluatorId])
}

/// Previous values of a score. §28 requires that re-scoring not destroy what came
/// before; rather than versioning the live row and complicating every read, the
/// superseded value is copied here on each change.
model QuotationScoreHistory {
  id         String   @id @default(cuid())
  scoreId    String
  score      Float
  notes      String?
  scoredById String?
  scoredAt   DateTime
  replacedAt DateTime @default(now())

  scoreRef QuotationScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([scoreId])
}

// ---------------------------------------------------------------------------
// CLARIFICATIONS
// ---------------------------------------------------------------------------

/// Who may read a clarification. PRIVATE keeps a question between one supplier
/// and the buyer; ALL_SUPPLIERS turns the answer into a notice every invited
/// supplier sees, which is what a change to a requirement demands. The asking
/// supplier's identity is never exposed either way — §19.
enum ClarificationVisibility {
  PRIVATE
  ALL_SUPPLIERS
}

enum ClarificationStatus {
  OPEN
  ANSWERED
  CLOSED
}

model RFQClarification {
  id                    String                  @id @default(cuid())
  organizationId        String
  rfqId                 String
  /// The supplier who asked. Null for a buyer-issued notice that answers nobody
  /// in particular.
  vendorId              String?
  askedBySupplierUserId String?
  /// Set when procurement raises the notice itself rather than answering a question.
  askedByUserId         String?
  question              String
  answer                String?
  visibility            ClarificationVisibility @default(PRIVATE)
  status                ClarificationStatus     @default(OPEN)
  answeredById          String?
  answeredAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfq                 RFQ           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor              Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  askedBySupplierUser SupplierUser? @relation(fields: [askedBySupplierUserId], references: [id], onDelete: SetNull)
  askedByUser         User?         @relation("ClarificationAskedBy", fields: [askedByUserId], references: [id], onDelete: SetNull)
  answeredBy          User?         @relation("ClarificationAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([rfqId])
  @@index([rfqId, visibility])
  @@index([vendorId])
  @@index([askedBySupplierUserId])
  @@index([askedByUserId])
  @@index([answeredById])
}

// ---------------------------------------------------------------------------
// AWARD
// ---------------------------------------------------------------------------

enum AwardRecommendationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AwardType {
  FULL
  PARTIAL
}

/// The proposal to award, kept separate from the award itself.
///
/// This is the document the approval engine acts on, and the reason an award can
/// be defended: it records who proposed it, on what evaluation, for how much, and
/// what the approver saw. An award created without one is possible only where the
/// organization has no award workflow configured.
model AwardRecommendation {
  id                String                    @id @default(cuid())
  organizationId    String
  rfqId             String
  quotationId       String
  vendorId          String
  type              AwardType                 @default(FULL)
  status            AwardRecommendationStatus @default(DRAFT)
  recommendedAmount Decimal                   @db.Decimal(18, 4)
  currency          String                    @default("USD")
  /// Why this supplier. Mandatory before submission — an award recommendation
  /// with no stated reason is not a recommendation.
  justification     String
  /// Snapshot of the evaluation at the moment of recommending: ranks, weighted
  /// scores, totals. Held as jsonb so a later re-score cannot rewrite the basis
  /// on which the approver decided.
  evaluationSummary Json?
  recommendedById   String?
  submittedAt       DateTime?
  decidedById       String?
  decidedAt         DateTime?
  decisionReason    String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfq           RFQ                       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation     Quotation                 @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  vendor        Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  recommendedBy User?                     @relation("AwardRecommendedBy", fields: [recommendedById], references: [id], onDelete: SetNull)
  decidedBy     User?                     @relation("AwardDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  items         AwardRecommendationItem[]
  awards        RFQAward[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([rfqId])
  @@index([quotationId])
  @@index([vendorId])
  @@index([recommendedById])
  @@index([decidedById])
}

/// The specific lines being awarded. Present even for a full award, so that the
/// purchase order phase has an explicit list to consume rather than having to
/// re-derive one from the quotation.
model AwardRecommendationItem {
  id                  String  @id @default(cuid())
  recommendationId    String
  rfqLineItemId       String?
  quotationLineItemId String?
  quantity            Decimal @db.Decimal(18, 4)
  unitPrice           Decimal @db.Decimal(18, 4)
  lineTotal           Decimal @db.Decimal(18, 4)

  recommendation    AwardRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  rfqLineItem       RFQLineItem?        @relation(fields: [rfqLineItemId], references: [id], onDelete: SetNull)
  quotationLineItem QuotationLineItem?  @relation(fields: [quotationLineItemId], references: [id], onDelete: SetNull)

  @@index([recommendationId])
  @@index([rfqLineItemId])
  @@index([quotationLineItemId])
}

/// The award decision itself, kept as a record rather than as a flag on the RFQ.
/// An RFQ may be split across suppliers, and a cancelled award must remain visible.
model RFQAward {
  id               String    @id @default(cuid())
  organizationId   String
  rfqId            String
  quotationId      String
  vendorId         String
  recommendationId String?
  type             AwardType @default(FULL)
  awardedAmount    Decimal   @db.Decimal(18, 4)
  currency         String    @default("USD")
  justification    String?
  awardedById      String?
  approvedById     String?
  awardedAt        DateTime  @default(now())
  cancelledAt      DateTime?
  cancelledReason  String?

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rfq            RFQ                  @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation      Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  vendor         Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  recommendation AwardRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  awardedBy      User?                @relation(fields: [awardedById], references: [id], onDelete: SetNull)
  approvedBy     User?                @relation("RFQAwardApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
  @@index([rfqId])
  @@index([vendorId])
  @@index([quotationId])
  @@index([awardedById])
  @@index([approvedById])
  @@index([recommendationId])
}

// ===========================================================================

// PURCHASE ORDERS
// ===========================================================================

// PO lifecycle. Enforced by the state machine, and driven by cumulative receipts
// rather than set by hand: PARTIALLY_RECEIVED and RECEIVED are computed from the
// receipt ledger, never asserted by a caller.
enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ISSUED
  ACKNOWLEDGED
  IN_DELIVERY
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  poNumber       String
  requestId      String?
  rfqId          String?
  quotationId    String?
  vendorId       String
  contractId     String?
  awardId        String?
  departmentId   String?
  costCenterId   String?
  budgetId       String?
  categoryId     String?
  status         PurchaseOrderStatus @default(DRAFT)

  subtotal       Decimal @default(0) @db.Decimal(18, 4)
  taxRate        Decimal @default(0) @db.Decimal(9, 4)
  taxAmount      Decimal @default(0) @db.Decimal(18, 4)
  discountAmount Decimal @default(0) @db.Decimal(18, 4)
  totalAmount    Decimal @default(0) @db.Decimal(18, 4)
  currency       String  @default("USD")

  termsAndConditions String?
  notes              String?
  deliveryAddress    String?
  paymentTerms       String?

  version          Int       @default(1)
  approvedById     String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  issuedAt         DateTime?
  acknowledgedAt   DateTime?
  expectedDelivery DateTime?
  receivedAt       DateTime?
  closedAt         DateTime?
  cancelledAt      DateTime?
  cancelledReason  String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      PurchaseRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  rfq          RFQ?                 @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  quotation    Quotation?           @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  vendor       Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  contract     Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  award        RFQAward?            @relation(fields: [awardId], references: [id], onDelete: SetNull)
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  costCenter   CostCenter?          @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  budget       Budget?              @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  categoryRef  ProcurementCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  lineItems      POLineItem[]
  revisions      PORevision[]
  goodsReceipts  GoodsReceipt[]
  invoices       Invoice[]
  assets         Asset[]
  stockMovements StockMovement[]
  activities     ActivityLog[]
  budgetEntries  BudgetEntry[]

  @@unique([organizationId, poNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([vendorId])
  @@index([requestId])
  @@index([budgetId])
  @@index([costCenterId])
  @@index([departmentId])
  @@index([contractId])
  @@index([organizationId, createdAt])
  @@index([rfqId])
  @@index([quotationId])
  @@index([awardId])
  @@index([categoryId])
}

// The four-quantity model required by the P2P lifecycle:
// ordered ≠ received ≠ invoiced ≠ paid. Each is tracked independently per line.
model POLineItem {
  id                  String   @id @default(cuid())
  purchaseOrderId     String
  // Traceability back up the chain: which request line asked for this, and which
  // quoted line priced it.
  requestLineItemId   String?
  quotationLineItemId String?
  warehouseId         String?
  itemName            String
  description         String?
  unit                String   @default("unit")
  unitPrice           Decimal  @db.Decimal(18, 4)
  taxRate             Decimal  @default(0) @db.Decimal(9, 4)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  orderedQty  Decimal @default(0) @db.Decimal(18, 4)
  receivedQty Decimal @default(0) @db.Decimal(18, 4)
  rejectedQty Decimal @default(0) @db.Decimal(18, 4)
  invoicedQty Decimal @default(0) @db.Decimal(18, 4)

  // Set when this line should become a tracked asset on receipt.
  createsAsset    Boolean @default(false)
  assetCategory   String?
  // Set when this line should post into inventory on receipt.
  inventoryItemId String?

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  receiptItems  GoodsReceiptItem[]
  warehouse     Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  invoiceLines  InvoiceLineItem[]

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
  @@index([warehouseId])
}

model PORevision {
  id              String   @id @default(cuid())
  purchaseOrderId String
  version         Int
  reason          String
  // JSON snapshot of the PO at this version.
  snapshot        String?
  modifiedById    String
  modifiedAt      DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, version])
  @@index([purchaseOrderId])
}

// ===========================================================================
// GOODS RECEIVING
// ===========================================================================

enum GoodsReceiptStatus {
  DRAFT
  PENDING
  PARTIAL
  RECEIVED
  REJECTED
}

enum ReceiptItemCondition {
  GOOD
  DAMAGED
  MISSING
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  organizationId  String
  receiptNumber   String
  purchaseOrderId String
  vendorId        String
  receivedById    String
  status          GoodsReceiptStatus @default(DRAFT)
  receivedDate    DateTime           @default(now())
  location        String?
  warehouseId     String?
  carrier         String?
  waybillNumber   String?
  inspectedById   String?
  inspectedAt     DateTime?
  deliveryNoteRef String?
  notes           String?
  postedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder  PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  vendor         Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  receivedBy     User               @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  warehouse      Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items          GoodsReceiptItem[]
  invoices       Invoice[]
  assets         Asset[]
  stockMovements StockMovement[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([receivedById])
  @@index([warehouseId])
}

model GoodsReceiptItem {
  id             String               @id @default(cuid())
  goodsReceiptId String
  poLineItemId   String
  itemName       String
  orderedQty     Decimal              @db.Decimal(18, 4)
  receivedQty    Decimal              @default(0) @db.Decimal(18, 4)
  // Four independent quantities per delivered line. `receivedQty` means *accepted*
  // into stock; damaged and rejected units are recorded but never posted to it.
  deliveredQty   Decimal              @default(0) @db.Decimal(18, 4)
  rejectedQty    Decimal              @default(0) @db.Decimal(18, 4)
  damagedQty     Decimal              @default(0) @db.Decimal(18, 4)
  batchNumber    String?
  expiryDate     DateTime?
  // JSON array of serial numbers, for lines that become tracked assets.
  serialNumbers  Json?
  warehouseId    String?
  unit           String               @default("unit")
  condition      ReceiptItemCondition @default(GOOD)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poLineItem   POLineItem   @relation(fields: [poLineItemId], references: [id], onDelete: Restrict)
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  assets       Asset[]

  @@index([goodsReceiptId])
  @@index([poLineItemId])
  @@index([warehouseId])
}

// ===========================================================================
// INVOICES
// ===========================================================================

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MATCHED
  APPROVED
  REJECTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
}

enum MatchStatus {
  NOT_MATCHED
  MATCHED
  PRICE_VARIANCE
  QUANTITY_VARIANCE
  NO_RECEIPT
  NO_PO
}

model Invoice {
  id               String        @id @default(cuid())
  organizationId   String
  invoiceNumber    String
  // The vendor's own invoice reference — used for duplicate detection.
  vendorInvoiceRef String?
  vendorId         String
  purchaseOrderId  String?
  goodsReceiptId   String?
  costCenterId     String?
  departmentId     String?
  paymentTerms     String?
  status           InvoiceStatus @default(DRAFT)

  issueDate   DateTime
  dueDate     DateTime
  subtotal    Decimal  @default(0) @db.Decimal(18, 4)
  taxAmount   Decimal  @default(0) @db.Decimal(18, 4)
  totalAmount Decimal  @default(0) @db.Decimal(18, 4)
  paidAmount  Decimal  @default(0) @db.Decimal(18, 4)
  balance     Decimal  @default(0) @db.Decimal(18, 4)
  currency    String   @default("USD")

  // 3-way match outcome (PO ↔ receipt ↔ invoice), computed by the matching service.
  matchStatus   MatchStatus @default(NOT_MATCHED)
  matchVariance Decimal?    @db.Decimal(18, 4)
  matchNotes    String?
  matchedAt     DateTime?
  isDuplicateOf String?

  notes          String?
  submittedById  String?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor          Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt    GoodsReceipt?           @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  approvedBy      User?                   @relation("InvoiceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  costCenter      CostCenter?             @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  matchExceptions InvoiceMatchException[]
  allocations     PaymentAllocation[]
  lineItems       InvoiceLineItem[]
  payments        Payment[]
  budgetEntries   BudgetEntry[]

  @@unique([organizationId, invoiceNumber])
  // Guards against the same vendor invoice being entered twice.
  @@unique([organizationId, vendorId, vendorInvoiceRef])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([vendorId])
  @@index([dueDate])
  @@index([purchaseOrderId])
  @@index([goodsReceiptId])
  @@index([organizationId, matchStatus])
  @@index([approvedById])
  @@index([costCenterId])
}

model InvoiceLineItem {
  id           String   @id @default(cuid())
  invoiceId    String
  poLineItemId String?
  itemName     String
  description  String?
  quantity     Decimal  @db.Decimal(18, 4)
  unit         String   @default("unit")
  unitPrice    Decimal  @db.Decimal(18, 4)
  taxRate      Decimal  @default(0) @db.Decimal(9, 4)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  invoice    Invoice                 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  poLineItem POLineItem?             @relation(fields: [poLineItemId], references: [id], onDelete: SetNull)
  exceptions InvoiceMatchException[]

  @@index([invoiceId])
  @@index([poLineItemId])
}

// ===========================================================================
enum MatchExceptionType {
  PRICE_VARIANCE
  QUANTITY_VARIANCE
  OVER_INVOICED
  NOT_RECEIVED
  NO_PO_LINE
  DUPLICATE
  TAX_VARIANCE
  CURRENCY_MISMATCH
}

enum MatchExceptionStatus {
  OPEN
  ACCEPTED
  DISPUTED
  RESOLVED
}

// One line-level failure of the three-way match. The invoice keeps a headline
// matchStatus; these rows are the evidence behind it — what was ordered, what
// was received, what was billed, and by how much they differ.
model InvoiceMatchException {
  id             String               @id @default(cuid())
  organizationId String
  invoiceId      String
  invoiceLineId  String?
  poLineItemId   String?
  type           MatchExceptionType
  status         MatchExceptionStatus @default(OPEN)
  orderedQty     Decimal?             @db.Decimal(18, 4)
  receivedQty    Decimal?             @db.Decimal(18, 4)
  invoicedQty    Decimal?             @db.Decimal(18, 4)
  orderedPrice   Decimal?             @db.Decimal(18, 4)
  invoicedPrice  Decimal?             @db.Decimal(18, 4)
  variance       Decimal?             @db.Decimal(18, 4)
  variancePct    Float?
  // The tolerance in force when the match ran, so a later policy change does not
  // silently reinterpret an old exception.
  tolerancePct   Float?
  detail         String?
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceLine  InvoiceLineItem? @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  resolvedBy   User?            @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([invoiceId])
  @@index([invoiceLineId])
  @@index([resolvedById])
}

// PAYMENTS
// ===========================================================================

enum PaymentStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  CARD
  MOBILE_MONEY
  WIRE
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  paymentNumber  String
  invoiceId      String
  vendorId       String
  amount         Decimal       @db.Decimal(18, 4)
  currency       String        @default("USD")
  method         PaymentMethod @default(BANK_TRANSFER)
  status         PaymentStatus @default(DRAFT)

  scheduledFor DateTime?
  paymentDate  DateTime?
  reference    String?
  notes        String?

  // Finance approval gate — a payment cannot leave PENDING_APPROVAL without this.
  approvedById String?
  approvedAt   DateTime?

  // Seam for a future payment provider. Deliberately inert: no provider is
  // implemented, and nothing in the app claims one is connected.
  providerName   String?
  providerRef    String?
  providerStatus String?
  failureReason  String?

  reconciledAt      DateTime?
  reconciledById    String?
  reconciledAmount  Decimal?  @db.Decimal(18, 4)
  reconciliationRef String?

  processedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice       Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  vendor        Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  processedBy   User                 @relation(fields: [processedById], references: [id], onDelete: Restrict)
  budgetEntries BudgetEntry[]
  allocations   PaymentAllocation[]
  transactions  PaymentTransaction[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([invoiceId])
  @@index([vendorId])
  @@index([processedById])
}

// ===========================================================================
// How a payment is split across invoices. A payment keeps invoiceId for the
// common single-invoice case; the allocations are what invoice balances are
// derived from, so one consolidated payment settles five invoices by the right
// amount each rather than by a guess.
model PaymentAllocation {
  id             String   @id @default(cuid())
  organizationId String
  paymentId      String
  invoiceId      String
  vendorId       String
  amount         Decimal  @db.Decimal(18, 4)
  currency       String   @default("USD")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([organizationId])
  @@index([invoiceId])
  @@index([vendorId])
}

// Every attempt to move the money, including the failures. This is the seam a
// payment provider plugs into. No provider is implemented; the table records
// that honestly rather than pretending otherwise.
model PaymentTransaction {
  id              String        @id @default(cuid())
  paymentId       String
  attempt         Int           @default(1)
  status          PaymentStatus
  provider        String?
  providerRef     String?
  amount          Decimal       @db.Decimal(18, 4)
  currency        String        @default("USD")
  // Provider envelopes, credential-redacted before storage.
  requestPayload  Json?
  responsePayload Json?
  errorCode       String?
  errorMessage    String?
  occurredAt      DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, attempt])
  @@index([paymentId])
}

// BUDGETS
// ===========================================================================

enum BudgetStatus {
  ACTIVE
  EXHAUSTED
  EXCEEDED
  CLOSED
}

model Budget {
  id             String       @id @default(cuid())
  organizationId String
  departmentId   String
  costCenterId   String?
  name           String?
  ownerId        String?
  fiscalYear     Int
  fiscalQuarter  Int?
  totalAmount    Decimal      @db.Decimal(18, 4)
  currency       String       @default("USD")
  status         BudgetStatus @default(ACTIVE)

  // Denormalised rollups of BudgetEntry, maintained transactionally.
  reservedAmount  Decimal @default(0) @db.Decimal(18, 4)
  committedAmount Decimal @default(0) @db.Decimal(18, 4)
  // The full chain, each figure backed by BudgetEntry rows of the matching type:
  //   requested -> reserved -> committed -> invoiced (spent) -> paid
  requestedAmount Decimal @default(0) @db.Decimal(18, 4)
  spentAmount     Decimal @default(0) @db.Decimal(18, 4)
  invoicedAmount  Decimal @default(0) @db.Decimal(18, 4)
  paidAmount      Decimal @default(0) @db.Decimal(18, 4)
  remainingAmount Decimal @default(0) @db.Decimal(18, 4)

  // Hard stop: reject commitments that would exceed the budget.
  enforceHardLimit Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  costCenter     CostCenter?       @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  requests       PurchaseRequest[]
  purchaseOrders PurchaseOrder[]
  categories     BudgetCategory[]
  alerts         BudgetAlert[]
  entries        BudgetEntry[]

  @@unique([organizationId, departmentId, fiscalYear, fiscalQuarter])
  @@index([organizationId])
  @@index([departmentId])
  @@index([costCenterId])
}

model BudgetCategory {
  id        String   @id @default(cuid())
  budgetId  String
  name      String
  allocated Decimal  @default(0) @db.Decimal(18, 4)
  spent     Decimal  @default(0) @db.Decimal(18, 4)
  committed Decimal  @default(0) @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, name])
  @@index([budgetId])
}

model BudgetAlert {
  id          String    @id @default(cuid())
  budgetId    String
  threshold   Float
  triggered   Boolean   @default(false)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

// Ledger movement types. Together they reconstruct every rollup on the budget:
//
//   REQUESTED  request submitted        demand signal, not yet a claim
//   RESERVED   request approved         claim on the budget
//   COMMITTED  PO issued                contractual obligation
//   SPENT      invoice approved         liability recognised
//   PAID       payment completed        cash out
//   RELEASED   cancelled or rejected    negates an earlier claim
enum BudgetEntryType {
  REQUESTED
  RESERVED
  COMMITTED
  SPENT
  PAID
  RELEASED
}

// Append-only ledger behind the budget rollups. Every movement through
// approved → ordered → invoiced → paid writes a row here, so the budget
// figures are always reconstructable rather than merely asserted.
model BudgetEntry {
  id              String          @id @default(cuid())
  budgetId        String
  type            BudgetEntryType
  amount          Decimal         @db.Decimal(18, 4)
  categoryName    String?
  costCenterId    String?
  currency        String          @default("USD")
  requestId       String?
  purchaseOrderId String?
  invoiceId       String?
  paymentId       String?
  description     String?
  createdById     String?
  createdAt       DateTime        @default(now())

  budget        Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  request       PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  invoice       Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment       Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([requestId])
  @@index([purchaseOrderId])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([budgetId, type])
}

// ===========================================================================
// CONTRACTS
// ===========================================================================

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  RENEWED
}

model Contract {
  id                 String         @id @default(cuid())
  organizationId     String
  contractNumber     String
  title              String
  vendorId           String
  status             ContractStatus @default(DRAFT)
  departmentId       String?
  categoryId         String?
  ownerId            String?
  // Contract type drives which obligations and renewal rules apply.
  contractType       ContractType   @default(PURCHASE)
  startDate          DateTime
  endDate            DateTime
  value              Decimal        @default(0) @db.Decimal(18, 4)
  currency           String         @default("USD")
  autoRenew          Boolean        @default(false)
  renewalNoticeDays  Int            @default(30)
  renewalAlertSentAt DateTime?
  slaTerms           String?
  description        String?
  // JSON string array.
  tags               String?
  version            Int            @default(1)
  renewedFromId      String?
  terminatedAt       DateTime?
  terminatedReason   String?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  categoryRef    ProcurementCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions       ContractVersion[]
  obligations    ContractObligation[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([vendorId])
  @@index([endDate])
  @@index([departmentId])
  @@index([categoryId])
}

model ContractVersion {
  id           String   @id @default(cuid())
  contractId   String
  version      Int
  reason       String
  snapshot     String?
  modifiedById String
  modifiedAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, version])
  @@index([contractId])
}

enum ObligationStatus {
  PENDING
  MET
  BREACHED
  WAIVED
}

model ContractObligation {
  id          String           @id @default(cuid())
  contractId  String
  description String
  dueDate     DateTime?
  status      ObligationStatus @default(PENDING)
  ownerId     String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([dueDate])
}

// ===========================================================================
enum DepreciationMethod {
  NONE
  STRAIGHT_LINE
  REDUCING_BALANCE
}

enum ContractType {
  PURCHASE
  SERVICE
  FRAMEWORK
  LEASE
  SLA
  NDA
  OTHER
}

// ASSETS
// ===========================================================================

enum AssetStatus {
  IN_USE
  IN_STORAGE
  UNDER_REPAIR
  RETIRED
  LOST
  ASSIGNED
  DISPOSED
}

enum AssetCategory {
  IT_EQUIPMENT
  FURNITURE
  VEHICLE
  MACHINERY
  TOOL
  BUILDING
  OTHER
}

model Asset {
  id                 String        @id @default(cuid())
  organizationId     String
  assetTag           String
  name               String
  category           AssetCategory @default(OTHER)
  serialNumber       String?
  purchaseOrderId    String?
  goodsReceiptId     String?
  goodsReceiptItemId String?
  poLineItemId       String?
  vendorId           String?
  assignedToId       String?
  departmentId       String?
  branchId           String?
  location           String?
  status             AssetStatus   @default(IN_STORAGE)

  purchaseDate       DateTime?
  purchaseValue      Decimal            @default(0) @db.Decimal(18, 4)
  currentValue       Decimal            @default(0) @db.Decimal(18, 4)
  currency           String             @default("USD")
  depreciationRate   Decimal            @default(0) @db.Decimal(9, 4)
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeMonths   Int?
  salvageValue       Decimal            @default(0) @db.Decimal(18, 4)
  warrantyExpiry     DateTime?

  qrCode         String?
  notes          String?
  retiredAt      DateTime?
  disposedAt     DateTime?
  disposalReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt     GoodsReceipt?     @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  goodsReceiptItem GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id], onDelete: SetNull)
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  assignedTo       User?             @relation("AssetAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  maintenanceRecords AssetMaintenance[]
  transfers          AssetTransfer[]

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@index([goodsReceiptId])
  @@index([purchaseOrderId])
  @@index([departmentId])
  @@index([goodsReceiptItemId])
  @@index([vendorId])
  @@index([branchId])
}

enum MaintenanceType {
  PREVENTIVE
  REPAIR
  INSPECTION
  UPGRADE
}

model AssetMaintenance {
  id          String          @id @default(cuid())
  assetId     String
  type        MaintenanceType
  description String
  cost        Decimal         @default(0) @db.Decimal(18, 4)
  performedBy String?
  date        DateTime        @default(now())
  nextDueDate DateTime?
  createdById String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model AssetTransfer {
  id           String   @id @default(cuid())
  assetId      String
  fromUserId   String?
  toUserId     String?
  fromLocation String?
  toLocation   String?
  reason       String
  date         DateTime @default(now())
  createdById  String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

// ===========================================================================
// INVENTORY
// ===========================================================================

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
  RETURN
  DISPOSAL
}

model InventoryItem {
  id                 String    @id @default(cuid())
  organizationId     String
  sku                String
  name               String
  description        String?
  category           String?
  unit               String    @default("unit")
  quantity           Decimal   @default(0) @db.Decimal(18, 4)
  reorderLevel       Decimal   @default(0) @db.Decimal(18, 4)
  reorderQty         Decimal   @default(0) @db.Decimal(18, 4)
  unitCost           Decimal   @default(0) @db.Decimal(18, 4)
  currency           String    @default("USD")
  location           String?
  defaultWarehouseId String?
  barcode            String?
  isActive           Boolean   @default(true)
  binLocation        String?
  lastRestockDate    DateTime?
  supplierId         String?
  reorderAlertSentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Vendor?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  defaultWarehouse Warehouse?      @relation("ItemDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  balances         StockBalance[]
  movements        StockMovement[]
  poLineItems      POLineItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([supplierId])
  @@index([defaultWarehouseId])
}

// Append-only stock ledger. `balanceAfter` is written inside the same transaction
// as the item quantity update, so the ledger and the item can never disagree.
model StockMovement {
  id                 String            @id @default(cuid())
  itemId             String
  type               StockMovementType
  quantity           Decimal           @db.Decimal(18, 4)
  balanceAfter       Decimal           @db.Decimal(18, 4)
  unitCost           Decimal?          @db.Decimal(18, 4)
  reference          String?
  purchaseOrderId    String?
  goodsReceiptId     String?
  warehouseId        String?
  fromWarehouseId    String?
  toWarehouseId      String?
  goodsReceiptItemId String?
  fromLocation       String?
  toLocation         String?
  notes              String?
  performedById      String
  createdAt          DateTime          @default(now())

  item          InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt  GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  performedBy   User           @relation(fields: [performedById], references: [id], onDelete: Restrict)
  warehouse     Warehouse?     @relation("MovementWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  fromWarehouse Warehouse?     @relation("MovementFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouse   Warehouse?     @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([goodsReceiptId])
  @@index([warehouseId])
  @@index([itemId, createdAt])
  @@index([purchaseOrderId])
  @@index([performedById])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

// ===========================================================================
// A stocking location. Inventory is held per warehouse, not per organization, so
// "we have 40 in Lagos and none in Abuja" is answerable from the data.
model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  code           String
  name           String
  address        String?
  managerId      String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager      User?        @relation(fields: [managerId], references: [id], onDelete: SetNull)

  balances        StockBalance[]
  defaultForItems InventoryItem[]    @relation("ItemDefaultWarehouse")
  movements       StockMovement[]    @relation("MovementWarehouse")
  movementsFrom   StockMovement[]    @relation("MovementFromWarehouse")
  movementsTo     StockMovement[]    @relation("MovementToWarehouse")
  goodsReceipts   GoodsReceipt[]
  receiptItems    GoodsReceiptItem[]
  poLineItems     POLineItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([managerId])
}

// Per-item, per-warehouse quantity. The item-level `quantity` is the sum of these
// and is maintained in the same transaction as the movement that changed it, so
// the ledger, the balances and the item total can never disagree.
model StockBalance {
  id          String   @id @default(cuid())
  itemId      String
  warehouseId String
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  // Committed to an internal issue but not yet picked.
  reservedQty Decimal  @default(0) @db.Decimal(18, 4)
  binLocation String?
  updatedAt   DateTime @default(now()) @updatedAt

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseId])
  @@index([warehouseId])
}

// DOCUMENTS & FILE STORAGE
// ===========================================================================

enum DocumentCategory {
  PURCHASE_ORDER
  CONTRACT
  INVOICE
  QUOTATION
  DELIVERY_NOTE
  CERTIFICATE
  POLICY
  ATTACHMENT
  OTHER
}

enum DocumentEntityType {
  REQUEST
  PO
  RFQ
  QUOTATION
  VENDOR
  CONTRACT
  INVOICE
  PAYMENT
  ASSET
  GOODS_RECEIPT
  BUDGET
  DEPARTMENT
}

// The actual bytes. Separated from DocumentRecord so that a document can carry
// many versions, and so attachments elsewhere can reference storage without
// becoming library documents.
model StoredFile {
  id             String          @id @default(cuid())
  organizationId String
  storageKey     String          @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  checksum       String?
  // Where the bytes live. LOCAL is the filesystem root in FILE_STORAGE_ROOT;
  // SUPABASE is a Supabase Storage bucket, which is what serverless deploys use.
  provider       StorageProvider @default(LOCAL)
  bucket         String?
  uploadedById   String
  createdAt      DateTime        @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentVersions DocumentVersion[]
  vendorDocuments  VendorDocument[]

  @@index([organizationId])
}

model DocumentRecord {
  id                String              @id @default(cuid())
  organizationId    String
  name              String
  category          DocumentCategory    @default(OTHER)
  description       String?
  // JSON string array.
  tags              String?
  linkedEntityType  DocumentEntityType?
  linkedEntityId    String?
  currentVersion    Int                 @default(1)
  expiresAt         DateTime?
  // JSON array of UserRole literals permitted to read; null means org-wide.
  restrictedToRoles String?
  uploadedById      String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  versions     DocumentVersion[]
  accessLogs   DocumentAccessLog[]
  links        DocumentLink[]

  @@index([organizationId])
  @@index([linkedEntityType, linkedEntityId])
  @@index([expiresAt])
  @@index([uploadedById])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      Int
  storedFileId String?
  sizeLabel    String?
  note         String?
  uploadedById String
  uploadedAt   DateTime @default(now())

  document   DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)
  storedFile StoredFile?    @relation(fields: [storedFileId], references: [id], onDelete: SetNull)

  @@unique([documentId, version])
  @@index([documentId])
  @@index([storedFileId])
}

model DocumentAccessLog {
  id             String   @id @default(cuid())
  documentId     String
  userId         String?
  supplierUserId String?
  action         String
  ipAddress      String?
  createdAt      DateTime @default(now())

  document DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ===========================================================================
enum StorageProvider {
  LOCAL
  SUPABASE
}

// A document attached to a record. One document may be attached to many records —
// a supplier certificate that justifies an award, is referenced by the contract,
// and is filed against the vendor — which a single foreign key cannot express.
// DocumentRecord keeps its own `linkedEntity*` columns as the document's primary
// home; these rows are the additional attachments.
model DocumentLink {
  id             String             @id @default(cuid())
  organizationId String
  documentId     String
  entityType     DocumentEntityType
  entityId       String
  // What the attachment is for on this particular record: proof of delivery,
  // signed copy, supporting quote.
  purpose        String?
  linkedById     String?
  createdAt      DateTime           @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)
  linkedBy     User?          @relation(fields: [linkedById], references: [id], onDelete: SetNull)

  @@unique([documentId, entityType, entityId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([linkedById])
}

// ACTIVITY, AUDIT, NOTIFICATIONS
// ===========================================================================

enum Severity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model ActivityLog {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String?
  requestId       String?
  purchaseOrderId String?
  rfqId           String?
  vendorId        String?
  eventType       String
  description     String
  severity        Severity @default(INFO)
  ipAddress       String?
  userAgent       String?
  // JSON blob.
  metadata        Json?
  createdAt       DateTime @default(now())

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  request       PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  rfq           RFQ?             @relation(fields: [rfqId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([requestId])
  @@index([userId])
  @@index([purchaseOrderId])
  @@index([rfqId])
}

// Append-only. There is no update or delete path to this table anywhere in the
// application — see `src/server/audit.ts`.
model AuditLogEntry {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  supplierUserId String?
  action         String
  resource       String
  resourceId     String?
  // JSON snapshots captured server-side, never supplied by the client.
  // Server-captured snapshots, stored as jsonb so audit queries can filter on
  // what actually changed rather than string-matching a blob.
  before         Json?
  after          Json?
  // Field names that differ between before and after.
  changedFields  String[]
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([resource, resourceId])
  @@index([userId])
}

enum NotificationType {
  info
  success
  warning
  approval
  error
  mention
  budget
  sla
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  title          String
  message        String
  type           NotificationType @default(info)
  read           Boolean          @default(false)
  readAt         DateTime?
  link           String?
  entityType     String?
  entityId       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([organizationId, createdAt])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  channelInApp    Boolean @default(true)
  channelEmail    Boolean @default(true)
  channelPush     Boolean @default(false)
  channelSlack    Boolean @default(false)
  channelTeams    Boolean @default(false)
  channelWhatsapp Boolean @default(false)
  channelSms      Boolean @default(false)

  catApprovals      Boolean @default(true)
  catRequests       Boolean @default(true)
  catRfqs           Boolean @default(true)
  catPurchaseOrders Boolean @default(true)
  catBudgetAlerts   Boolean @default(true)
  catSlaWarnings    Boolean @default(true)
  catMentions       Boolean @default(true)
  catWeeklyDigest   Boolean @default(false)

  quietHoursStart String?
  quietHoursEnd   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Outbound delivery attempts for notifications routed to email/Slack/SMS.
// Gives notification delivery the same observability integrations get.
model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String?
  channel        String
  recipient      String
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([notificationId])
}

// ===========================================================================
// Transactional outbox. Domain events are written here inside the same
// transaction as the business change that caused them, then dispatched by a
// drainer. Without this a notification can be sent for an approval that later
// rolled back, or a committed approval can silently notify nobody.
model EventOutbox {
  id             String    @id @default(cuid())
  organizationId String
  type           String
  entityType     String?
  entityId       String?
  payload        Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

// INTEGRATIONS
// ===========================================================================

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
  CONFIGURING
}

enum IntegrationHealth {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum SyncFrequency {
  REAL_TIME
  HOURLY
  DAILY
  WEEKLY
  MANUAL
}

model Integration {
  id             String            @id @default(cuid())
  organizationId String
  type           String
  name           String
  status         IntegrationStatus @default(DISCONNECTED)
  healthStatus   IntegrationHealth @default(UNKNOWN)
  syncFrequency  SyncFrequency     @default(MANUAL)

  // Encrypted credential blob. Never returned to the client — the API projects
  // only which keys are set, never their values.
  encryptedConfig String?
  // JSON array of non-secret settings safe to echo back.
  publicConfig    String?
  // JSON array of event keys this integration subscribes to.
  enabledEvents   String?

  lastSyncAt     DateTime?
  lastSyncStatus String?
  lastError      String?
  configuredById String?
  configuredAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs         IntegrationLog[]

  @@unique([organizationId, type])
  @@index([organizationId])
}

model IntegrationLog {
  id            String   @id @default(cuid())
  integrationId String
  event         String
  status        String
  message       String?
  durationMs    Int?
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
}

// Outbound webhook queue with retry/backoff, so integration delivery is
// observable and replayable rather than fire-and-forget.
model WebhookDelivery {
  id             String    @id @default(cuid())
  organizationId String
  integrationId  String?
  url            String
  event          String
  payload        Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  nextAttemptAt  DateTime?
  responseStatus Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([organizationId])
}

// ===========================================================================
// SAVED VIEWS, AI, SIGNATURES
// ===========================================================================

enum SavedViewEntity {
  REQUESTS
  VENDORS
  POS
  RFQS
  INVOICES
  PAYMENTS
  CONTRACTS
  ASSETS
}

model SavedView {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  name           String
  entityType     SavedViewEntity
  // JSON filter blob.
  filters        String
  isShared       Boolean         @default(false)
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model AIConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  entityType     String?
  entityId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
  @@index([organizationId])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  // JSON array of follow-up suggestions.
  suggestions    String?
  // Records which org-scoped data the answer was grounded in, so an AI response
  // is auditable against the permissions of the user who asked.
  groundingRefs  String?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum SignatureEntityType {
  PO
  CONTRACT
  REQUEST
  INVOICE
}

enum SignatureMethod {
  CLICK_SIGN
  OTP
  CERTIFICATE
  BIO_METRIC
}

model DigitalSignature {
  id             String              @id @default(cuid())
  organizationId String
  entityType     SignatureEntityType
  entityId       String
  signerId       String
  signerName     String
  signerRole     UserRole
  method         SignatureMethod     @default(CLICK_SIGN)
  ipAddress      String?
  userAgent      String?
  metadata       String?
  signedAt       DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signer       User         @relation(fields: [signerId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([signerId])
}

// ===========================================================================
// INFRASTRUCTURE
// ===========================================================================

// Backs per-tenant document numbering without a table scan or a race.
model DocumentSequence {
  id             String   @id @default(cuid())
  organizationId String
  prefix         String
  period         String
  lastValue      Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, prefix, period])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
