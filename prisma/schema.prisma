// NextMav Procure — Prisma Schema
// Production-grade data model for a multi-tenant Procure-to-Pay platform.
// Note: The interactive demo runs on a Zustand store seeded with realistic data,
// but this schema documents the canonical persistence model for a real deployment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenant organization. Every other tenant-scoped table carries orgId.
// ---------------------------------------------------------------------------
model Organization {
  id            String         @id @default(cuid())
  name          String
  legalName     String?
  industry      String?
  country       String?
  currency      String         @default("USD")
  taxId         String?
  logoUrl       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  branches      Branch[]
  departments   Department[]
  users         User[]
  vendors       Vendor[]
  requests      PurchaseRequest[]
  rfqs          RFQ[]
  purchaseOrders PurchaseOrder[]
  activities    ActivityLog[]
  notifications Notification[]
}

model Branch {
  id            String         @id @default(cuid())
  organizationId String
  name          String
  address       String?
  city          String?
  country       String?
  createdAt     DateTime       @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments   Department[]
  users         User[]
}

model Department {
  id            String         @id @default(cuid())
  organizationId String
  branchId      String?
  name          String
  budget        Float?
  createdAt     DateTime       @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?         @relation(fields: [branchId], references: [id])
  users         User[]
  requests      PurchaseRequest[]
}

enum UserRole {
  SUPER_ADMIN
  PROCUREMENT_MANAGER
  FINANCE_OFFICER
  DEPARTMENT_MANAGER
  EMPLOYEE
  AUDITOR
}

model User {
  id            String         @id @default(cuid())
  organizationId String
  branchId      String?
  departmentId  String?
  email         String
  name          String
  role          UserRole       @default(EMPLOYEE)
  jobTitle      String?
  phone         String?
  avatarUrl     String?
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?         @relation(fields: [branchId], references: [id])
  department    Department?     @relation(fields: [departmentId], references: [id])
  requests      PurchaseRequest[]
  approvals     ApprovalStep[]
  activities    ActivityLog[]
  notifications Notification[]
}

// ---------------------------------------------------------------------------
// Vendor master
// ---------------------------------------------------------------------------
enum VendorStatus {
  ACTIVE
  PROSPECTIVE
  ARCHIVED
  BLACKLISTED
}

model Vendor {
  id            String         @id @default(cuid())
  organizationId String
  companyName   String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  category      String?
  taxNumber     String?
  bankName      String?
  bankAccount   String?
  rating        Float          @default(0)
  status        VendorStatus   @default(PROSPECTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotations    Quotation[]
  purchaseOrders PurchaseOrder[]
  rfqs          RFQVendor[]
}

// ---------------------------------------------------------------------------
// Purchase Requests (requisitions)
// ---------------------------------------------------------------------------
enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PurchaseRequest {
  id            String         @id @default(cuid())
  organizationId String
  requestNumber String
  title         String
  departmentId  String?
  requestedById String
  status        RequestStatus  @default(DRAFT)
  priority      Priority       @default(MEDIUM)
  businessJustification String?
  neededByDate  DateTime?
  totalEstimated Float         @default(0)
  currency      String         @default("USD")
  attachments   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  submittedAt   DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department?    @relation(fields: [departmentId], references: [id])
  requestedBy   User           @relation(fields: [requestedById], references: [id])
  lineItems     LineItem[]
  approvals     ApprovalStep[]
  rfqs          RFQ[]
  purchaseOrders PurchaseOrder[]
  activities    ActivityLog[]
}

model LineItem {
  id            String         @id @default(cuid())
  requestId     String
  itemName      String
  description   String?
  quantity      Float
  unit          String
  estimatedCost Float
  createdAt     DateTime       @default(now())

  request       PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

enum ApprovalStage {
  DEPARTMENT_MANAGER
  FINANCE
  PROCUREMENT
  EXECUTIVE
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model ApprovalStep {
  id            String         @id @default(cuid())
  requestId     String
  stage         ApprovalStage
  approverId    String
  decision      ApprovalDecision @default(PENDING)
  comment       String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  request       PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver      User           @relation(fields: [approverId], references: [id])
}

// ---------------------------------------------------------------------------
// RFQ → Quotation → PO
// ---------------------------------------------------------------------------
enum RFQStatus {
  WAITING
  RECEIVED
  EXPIRED
  CLOSED
}

model RFQ {
  id            String         @id @default(cuid())
  organizationId String
  rfqNumber     String
  requestId     String?
  title         String
  description   String?
  deadline      DateTime
  status        RFQStatus      @default(WAITING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request       PurchaseRequest? @relation(fields: [requestId], references: [id])
  vendors       RFQVendor[]
  quotations    Quotation[]
  purchaseOrders PurchaseOrder[]
}

model RFQVendor {
  id            String         @id @default(cuid())
  rfqId         String
  vendorId      String

  rfq           RFQ            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
}

model Quotation {
  id            String         @id @default(cuid())
  rfqId         String
  vendorId      String
  totalAmount   Float
  currency      String         @default("USD")
  deliveryDays  Int
  warranty      String?
  paymentTerms  String?
  validUntil    DateTime?
  notes         String?
  status        String         @default("RECEIVED")
  createdAt     DateTime       @default(now())

  rfq           RFQ            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
  IN_DELIVERY
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id            String         @id @default(cuid())
  organizationId String
  poNumber      String
  requestId     String?
  rfqId         String?
  quotationId   String?
  vendorId      String
  status        PurchaseOrderStatus @default(ISSUED)
  totalAmount   Float
  currency      String         @default("USD")
  taxRate       Float          @default(0)
  issuedAt      DateTime       @default(now())
  expectedDelivery DateTime?
  notes         String?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request       PurchaseRequest? @relation(fields: [requestId], references: [id])
  rfq           RFQ?           @relation(fields: [rfqId], references: [id])
  quotation     Quotation?     @relation(fields: [quotationId], references: [id])
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  activities    ActivityLog[]
}

// ---------------------------------------------------------------------------
// Activity log + notifications
// ---------------------------------------------------------------------------
model ActivityLog {
  id            String         @id @default(cuid())
  organizationId String
  userId        String?
  requestId     String?
  purchaseOrderId String?
  eventType     String
  description   String
  metadata      String?
  createdAt     DateTime       @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id])
  request       PurchaseRequest? @relation(fields: [requestId], references: [id])
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
}

model Notification {
  id            String         @id @default(cuid())
  organizationId String
  userId        String
  title         String
  message       String
  type          String
  read          Boolean        @default(false)
  link          String?
  createdAt     DateTime       @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id])
}
