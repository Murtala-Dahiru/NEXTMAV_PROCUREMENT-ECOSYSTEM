# NextMav Procure — required environment variables.
#
# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# Every value below must be unique per environment.

# --- Supabase project -----------------------------------------------------
# From the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Safe to ship to the browser. It authenticates as the `anon` role, which the
# RLS lockdown migration deliberately grants nothing: no application table is
# readable through the public REST API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only. Bypasses row-level security entirely — never import it into any
# file that ships to the browser, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."

# --- Database -------------------------------------------------------------
# Both URLs go through the Supavisor pooler. New Supabase projects reach the
# direct host (db.<ref>.supabase.co) over IPv6 only, which most CI runners and
# many workstations cannot route.
#
# DATABASE_URL is transaction mode (port 6543), used by the app at runtime.
# Serverless functions come and go per request, so connections must come from a
# pooler rather than opening a direct one each time.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=30"

# connection_limit sizes Prisma's own pool *inside one process*. A long-running
# server needs several — with 1, every request queues behind the last, and a
# request that opens a transaction blocks everything else in that process; the
# symptom is 10-20 second responses that look like a hang. Serverless is the
# opposite case: many short-lived containers, one connection each, so set
# connection_limit=1 on Vercel and similar platforms.

# pool_timeout is how long a query waits for a free connection before failing.
# The default is 10s, which is generous when the database is next door and much
# too tight when it is not: /api/bootstrap fans out 27 queries in one Promise.all,
# so against a database ~1.8s away they queue several deep and the last ones were
# aborting with "Timed out fetching a new connection from the connection pool" —
# surfacing as a 500 on the dashboard's first load. Raise this, not just the
# connection limit: the constraint is latency per query, not parallelism.

# DIRECT_DATABASE_URL is session mode (port 5432), used only by `prisma migrate`.
# Schema changes need a real session, which a transaction-mode pooler cannot give.
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# A password containing reserved characters must be percent-encoded: `+` is %2B,
# `@` is %40, `/` is %2F. An unencoded one produces a confusing "can't reach
# database server" rather than an authentication error.

# --- Authentication -------------------------------------------------------
# Supabase Auth is the identity provider for the internal (employee) realm. It
# owns credentials, email verification and password recovery; this application
# owns the mapping from an auth identity to an organization and a role.
#
# The origin Supabase returns users to from verification and recovery emails.
# It must match one of the redirect URLs configured in the Supabase dashboard
# (Authentication → URL Configuration) or Supabase refuses the redirect.
#
#   local        http://localhost:3000
#   production   https://your-deployment.vercel.app
#
# Deliberately not derived from the request's Host header: that header is
# attacker-controlled, and using it to build an emailed link is how host-header
# poisoning turns a password reset into an account takeover.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Signs and validates the *supplier* realm's sessions, which are still issued by
# this application rather than by Supabase. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""


# --- Sign-up & email delivery -----------------------------------------------
# Whether creating an account requires the user to confirm their email address.
#
# Read this before changing it. Supabase will not complete an `auth.signUp`
# without first SENDING a confirmation message. A project with no custom SMTP
# falls back to Supabase's built-in mailer, which is a development convenience:
# a couple of messages per hour, delivered only to your own Supabase team's
# addresses. Past that allowance every single sign-up is rejected with
#
#     HTTP 429  over_email_send_rate_limit
#
# *before any account is created* — so a long run of attempts leaves nothing
# behind and the form appears to be blaming the user for retrying.
#
#   false  (default) The account is created through the admin API with the
#          address pre-confirmed. Nothing is emailed, nothing is rate limited,
#          and sign-up completes on the first click. The address is accepted
#          without being proved — a real reduction in assurance, taken
#          knowingly because the alternative is a sign-up that cannot finish.
#
#   true   Supabase emails a verification link and owns the flow. Set this ONLY
#          after configuring a real SMTP provider, or you are back at the 429.
SIGNUP_REQUIRE_EMAIL_VERIFICATION="false"

# Set to "true" once SMTP is filled in under Supabase → Authentication → SMTP
# Settings (Resend, SendGrid, Postmark, Brevo, SES — any of them will do). This
# application never sends mail itself, so it cannot probe the transport; this
# flag is how it is told. Its only job is to make the one unworkable
# combination — verification required, no way to deliver it — fail loudly at
# startup instead of silently at the sign-up form.
SUPABASE_CUSTOM_SMTP_CONFIGURED="false"

# --- Encryption -----------------------------------------------------------
# AES-256-GCM key protecting integration credentials at rest (32-byte hex).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=""

# --- Storage --------------------------------------------------------------
# Filesystem root for uploaded documents. Serverless deployments have no durable
# filesystem; point StoredFile at a Supabase Storage bucket there instead.
FILE_STORAGE_ROOT="./storage"

# --- Realtime -------------------------------------------------------------
# Socket.IO mini-service in mini-services/notification-service.
# The platform runs correctly without it; live updates are simply unavailable.
REALTIME_SERVICE_URL="http://localhost:3003"
