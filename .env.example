# NextMav Procure — required environment variables.
#
# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# Every value below must be unique per environment.

# --- Supabase project -----------------------------------------------------
# From the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Safe to ship to the browser. It authenticates as the `anon` role, which the
# RLS lockdown migration deliberately grants nothing: no application table is
# readable through the public REST API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only. Bypasses row-level security entirely — never import it into any
# file that ships to the browser, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."

# --- Database -------------------------------------------------------------
# Both URLs go through the Supavisor pooler. New Supabase projects reach the
# direct host (db.<ref>.supabase.co) over IPv6 only, which most CI runners and
# many workstations cannot route.
#
# DATABASE_URL is transaction mode (port 6543), used by the app at runtime.
# Serverless functions come and go per request, so connections must come from a
# pooler rather than opening a direct one each time.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=10"

# connection_limit sizes Prisma's own pool *inside one process*. A long-running
# server needs several — with 1, every request queues behind the last, and a
# request that opens a transaction blocks everything else in that process; the
# symptom is 10-20 second responses that look like a hang. Serverless is the
# opposite case: many short-lived containers, one connection each, so set
# connection_limit=1 on Vercel and similar platforms.

# DIRECT_DATABASE_URL is session mode (port 5432), used only by `prisma migrate`.
# Schema changes need a real session, which a transaction-mode pooler cannot give.
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# A password containing reserved characters must be percent-encoded: `+` is %2B,
# `@` is %40, `/` is %2F. An unencoded one produces a confusing "can't reach
# database server" rather than an authentication error.

# --- Authentication -------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"

# Signs and validates sessions. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Encryption -----------------------------------------------------------
# AES-256-GCM key protecting integration credentials at rest (32-byte hex).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=""

# --- Storage --------------------------------------------------------------
# Filesystem root for uploaded documents. Serverless deployments have no durable
# filesystem; point StoredFile at a Supabase Storage bucket there instead.
FILE_STORAGE_ROOT="./storage"

# --- Realtime -------------------------------------------------------------
# Socket.IO mini-service in mini-services/notification-service.
# The platform runs correctly without it; live updates are simply unavailable.
REALTIME_SERVICE_URL="http://localhost:3003"
