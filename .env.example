# NextMav Procure — required environment variables.
#
# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# Every value below must be unique per environment.

# --- Database -------------------------------------------------------------
# SQLite for local development. The path is resolved relative to prisma/schema.prisma.
# For production, change the datasource provider in prisma/schema.prisma to
# postgresql and point this at the cluster.
DATABASE_URL="file:../db/custom.db"

# --- Authentication -------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"

# Signs and validates sessions. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Encryption -----------------------------------------------------------
# AES-256-GCM key protecting integration credentials at rest (32-byte hex).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=""

# --- Storage --------------------------------------------------------------
# Filesystem root for uploaded documents.
FILE_STORAGE_ROOT="./storage"

# --- Realtime -------------------------------------------------------------
# Socket.IO mini-service in mini-services/notification-service.
# The platform runs correctly without it; live updates are simply unavailable.
REALTIME_SERVICE_URL="http://localhost:3003"
