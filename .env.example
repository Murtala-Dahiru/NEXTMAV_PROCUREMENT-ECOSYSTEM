# NextMav Procure — required environment variables.
#
# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# Every value below must be unique per environment.

# --- Database -------------------------------------------------------------
# PostgreSQL. Neon (neon.tech) gives you both strings from the project dashboard.
#
# DATABASE_URL must be the POOLED connection (the host contains '-pooler'), used
# by the app at runtime. Serverless functions come and go per request, so
# connections have to come from a pooler or the database runs out of them.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# DIRECT_DATABASE_URL must be the UNPOOLED connection (no '-pooler'), used only by
# 'prisma migrate' and 'prisma db push'. Schema changes need a real session, which
# a transaction-mode pooler cannot give them.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Authentication -------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"

# Signs and validates sessions. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Encryption -----------------------------------------------------------
# AES-256-GCM key protecting integration credentials at rest (32-byte hex).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=""

# --- Storage --------------------------------------------------------------
# Filesystem root for uploaded documents.
FILE_STORAGE_ROOT="./storage"

# --- Realtime -------------------------------------------------------------
# Socket.IO mini-service in mini-services/notification-service.
# The platform runs correctly without it; live updates are simply unavailable.
REALTIME_SERVICE_URL="http://localhost:3003"
